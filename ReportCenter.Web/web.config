<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 部署設定
  ※ 登入改由 DataHubApi JWT + 本站 Cookie 處理：IIS 站台只開「匿名驗證」、關閉「Windows 驗證」，
     且必須以 https://*.prokits.com.tw 網址開啟 (見 docs/05-開發與部署.md)
  ※ 不要在此寫 <security><authentication>，該區段預設鎖定，寫入會 HTTP 500.19
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\ReportCenter.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="RC_CONFIG_PATH" value="C:\CompanySecrets\reportWebApp-Site.Production.json" />
          <environmentVariable name="SHARED_INFRA_PATH" value="C:\CompanySecrets\shared-infra.Production.json" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
