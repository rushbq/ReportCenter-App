@page
@model ErrorModel
@{
    Layout = null;
    ViewData["Title"] = "系統錯誤";
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReportCenter</title>
    <style>
        :root {
            color-scheme: light;
            --pri: #005758;
            --surface: #f5f7f8;
            --panel: #ffffff;
            --txt: #1a2e2f;
            --txt-sec: #5c7576;
            --bdr: #e2e8ea;
            --bad: #b93838;
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: linear-gradient(180deg, #eef5f5 0%, var(--surface) 100%);
            color: var(--txt);
            font-family: "Noto Sans TC", -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .card {
            width: min(100%, 720px);
            background: var(--panel);
            border: 1px solid var(--bdr);
            border-radius: 20px;
            box-shadow: 0 16px 48px rgba(0, 87, 88, 0.08);
            overflow: hidden;
        }

        .hero {
            padding: 28px 32px 20px;
            background: linear-gradient(135deg, rgba(0, 87, 88, 0.08), rgba(0, 180, 182, 0.06));
            border-bottom: 1px solid var(--bdr);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(220, 74, 74, 0.08);
            color: var(--bad);
            font-size: 13px;
            font-weight: 700;
        }

        .content {
            padding: 24px 32px 32px;
        }

        h1 {
            margin: 16px 0 10px;
            font-size: clamp(28px, 4vw, 36px);
            line-height: 1.15;
        }

        p {
            margin: 0;
            color: var(--txt-sec);
            line-height: 1.7;
        }

        dl {
            display: grid;
            grid-template-columns: 140px 1fr;
            gap: 10px 16px;
            margin: 28px 0 0;
        }

        dt {
            color: var(--txt-sec);
            font-size: 14px;
            font-weight: 600;
        }

        dd {
            margin: 0;
            color: var(--txt);
            font-size: 14px;
            word-break: break-word;
        }

        code {
            font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
            background: #f3f7f7;
            border: 1px solid var(--bdr);
            border-radius: 8px;
            padding: 2px 8px;
        }

        .actions {
            margin-top: 28px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 120px;
            padding: 12px 16px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

        .btn-primary {
            background: var(--pri);
            color: #fff;
        }

        .btn-secondary {
            background: #fff;
            color: var(--txt);
            border: 1px solid var(--bdr);
        }

        @@media (max-width: 640px) {
            .hero, .content { padding: 20px; }
            dl { grid-template-columns: 1fr; gap: 6px; }
        }
    </style>
</head>
<body>
    <section class="card">
        <div class="hero">
            <span class="badge">500 系統錯誤</span>
            <h1>系統處理請求時發生未預期錯誤</h1>
            <p>請將以下資訊提供給系統管理員，以便從應用程式 log 或 Seq 中追查對應的例外紀錄。</p>
        </div>
        <div class="content">
            <dl>
                @if (Model.ShowRequestId)
                {
                    <dt>Request ID</dt>
                    <dd><code>@Model.RequestId</code></dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.OriginalPath))
                {
                    <dt>Request Path</dt>
                    <dd><code>@Model.OriginalPath</code></dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ExceptionType))
                {
                    <dt>Exception Type</dt>
                    <dd><code>@Model.ExceptionType</code></dd>
                }
            </dl>

            <div class="actions">
                <a class="btn btn-primary" href="/">返回首頁</a>
                <a class="btn btn-secondary" href="javascript:location.reload()">重新整理</a>
            </div>
        </div>
    </section>
</body>
</html>
