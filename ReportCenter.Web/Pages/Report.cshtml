@page
@using ReportCenter.Web.Models
@model ReportCenter.Web.Pages.ReportModel

<div class="p-6 pb-10 max-w-[1200px]">
    <!-- Breadcrumb -->
    <div class="text-[12px] text-txt-ter mb-3.5 flex items-center gap-1">
        <a href="/" class="hover:text-pri no-underline text-txt-ter cursor-pointer">首頁</a><span>/</span>
        <a href="/Department?dept=@Model.DeptId" class="hover:text-pri no-underline text-txt-ter cursor-pointer">@Model.Dept.Label</a><span>/</span>
        <span class="text-pri font-semibold">@Model.ReportName</span>
    </div>

    <!-- Header -->
    <div class="flex justify-between items-start mb-5">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/Department?dept=@Model.DeptId" class="text-txt-ter flex no-underline">
                    <i data-lucide="chevron-left" class="w-[18px] h-[18px]"></i>
                </a>
                <h1 class="text-[20px] font-bold text-txt">@Model.ReportName</h1>
            </div>
            <div class="text-[12px] text-txt-ter pl-[26px]">@Model.Dept.Label ・ 成本分析 ・ 最後更新 2026/03/20 09:30</div>
        </div>
        <div class="flex gap-2">
            <span class="chip"><i data-lucide="star" class="w-3 h-3"></i>收藏</span>
            <span class="chip"><i data-lucide="file-spreadsheet" class="w-3 h-3"></i>Excel</span>
            <span class="chip"><i data-lucide="file-text" class="w-3 h-3"></i>PDF</span>
        </div>
    </div>

    <!-- Filter Bar (sticky) -->
    <div class="bg-white border border-bdr rounded-[10px] px-[18px] py-3 mb-5 flex gap-2 items-center shadow-sm sticky top-14 z-40">
        <span class="chip chip-active">2026/03</span>
        <span class="chip">物料類別: 全部</span>
        <span class="chip">供應商: 全部</span>
        <span class="chip chip-dashed">+ 更多</span>
        <div class="flex-1"></div>
        <span class="text-[12px] text-pri font-medium cursor-pointer">重設篩選</span>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-[1.6fr_1fr] gap-4 mb-5">
        <!-- Cost Trend -->
        <div class="bg-white border border-bdr rounded-xl p-5 shadow-sm">
            <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-txt">各類物料採購金額趨勢</span>
                <div class="flex gap-1">
                    <span class="chip chip-active">面積</span>
                    <span class="chip">長條</span>
                    <span class="chip">堆疊</span>
                </div>
            </div>
            <canvas id="costChart" height="240"></canvas>
        </div>
        <!-- Pie -->
        <div class="bg-white border border-bdr rounded-xl p-5 shadow-sm">
            <span class="font-semibold text-sm text-txt">採購佔比</span>
            <canvas id="pieChart" height="200" class="mt-2"></canvas>
            <div class="flex gap-3 justify-center flex-wrap mt-3">
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-pri inline-block"></span>原料 62%</span>
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-acc inline-block"></span>包材 18%</span>
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-pri-hover inline-block"></span>設備 12%</span>
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-txt-ter inline-block"></span>其他 8%</span>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-4 gap-3.5 mb-5">
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "本月總採購" }, { "value", "$4.2M" }, { "trend", "-3.1" }, { "note", "vs 上月" } }' />
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "最大項目" }, { "value", "原料 62%" }, { "trend", "1.2" }, { "note", "" } }' />
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "供應商數" }, { "value", "47 家" }, { "trend", "6.8" }, { "note", "+3 家" } }' />
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "平均單價" }, { "value", "-2.1%" }, { "trend", "-2.1" }, { "note", "" } }' />
    </div>

    <!-- Data Table -->
    <div class="bg-white border border-bdr rounded-xl overflow-hidden shadow-sm">
        <div class="flex justify-between items-center px-5 py-3.5 border-b border-bdr">
            <span class="font-semibold text-sm text-txt">明細資料</span>
            <span class="text-[11px] text-txt-ter">顯示 1-20 / 共 156 筆</span>
        </div>
        <!-- Header -->
        <div class="grid grid-cols-[2fr_1.5fr_1fr_0.8fr_1fr_0.8fr] px-5 py-2.5 bg-surface text-[11px] font-bold text-txt-ter uppercase tracking-wider">
            <span>物料名稱</span><span>供應商</span><span>數量</span><span>單價</span><span>金額</span><span>變化</span>
        </div>
        <!-- Rows -->
        @foreach (var r in ReportData.MaterialRows)
        {
            var isDown = r.Change < 0;
            <div class="grid grid-cols-[2fr_1.5fr_1fr_0.8fr_1fr_0.8fr] px-5 py-3 border-t border-bdr-light text-[13px] items-center">
                <span class="font-medium text-txt">@r.Material</span>
                <span class="text-txt-sec">@r.Supplier</span>
                <span>@r.Qty</span>
                <span>@r.UnitPrice</span>
                <span class="font-semibold text-pri">@r.Amount</span>
                <span class="inline-flex items-center gap-1 font-semibold text-[12px] @(isDown ? "text-ok" : "text-bad")">
                    @if (isDown)
                    {
                        <i data-lucide="arrow-down-right" class="w-3 h-3"></i>
                    }
                    else
                    {
                        <i data-lucide="arrow-up-right" class="w-3 h-3"></i>
                    }
                    @(r.Change > 0 ? "+" : "")@r.Change%
                </span>
            </div>
        }
        <!-- Pagination -->
        <div class="px-5 py-3 border-t border-bdr flex justify-between items-center">
            <span class="text-[11px] text-txt-ter">每頁 20 筆</span>
            <div class="flex gap-0.5">
                @foreach (var p in new[] { "◀", "1", "2", "3", "…", "8", "▶" })
                {
                    <span class="px-2.5 py-1 text-[12px] rounded-md cursor-pointer @(p == "1" ? "bg-pri text-white font-semibold" : "text-txt-ter")">@p</span>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .chip {
        font-size: 12px; padding: 5px 12px; border-radius: 6px; cursor: pointer;
        border: 1px solid #e2e8ea; background: white; color: #5c7576;
        white-space: nowrap; user-select: none; display: inline-flex; align-items: center; gap: 4px;
    }
    .chip-active {
        border-color: #005758; background: #e8f4f4; color: #005758; font-weight: 600;
    }
    .chip-dashed {
        border: 1.5px dashed #e2e8ea;
    }
</style>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const C = { pri: '#005758', acc: '#00b4b6', priH: '#006d6e', ter: '#94aeb0', borderL: '#eef2f3' };

    // Cost Trend Chart
    new Chart(document.getElementById('costChart'), {
        type: 'line',
        data: {
            labels: ['10月','11月','12月','1月','2月','3月'],
            datasets: [
                {
                    label: '原料', data: [2.5,2.7,2.9,2.6,2.8,2.6],
                    borderColor: C.pri, backgroundColor: C.pri + '30',
                    borderWidth: 2, fill: true, tension: 0.4, pointRadius: 0,
                },
                {
                    label: '包材', data: [0.8,0.7,0.9,0.8,0.7,0.8],
                    borderColor: C.acc, backgroundColor: C.acc + '30',
                    borderWidth: 2, fill: true, tension: 0.4, pointRadius: 0,
                },
                {
                    label: '設備', data: [0.6,0.5,0.7,0.4,0.6,0.5],
                    borderColor: C.priH, borderWidth: 1.5,
                    fill: false, tension: 0.4, pointRadius: 3,
                },
                {
                    label: '其他', data: [0.4,0.3,0.5,0.4,0.3,0.3],
                    borderColor: C.ter, borderWidth: 1, borderDash: [3,3],
                    fill: false, tension: 0.4, pointRadius: 0,
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter } },
                y: { grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter, callback: v => v + 'M' } }
            }
        }
    });

    // Pie Chart
    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: ['原料','包材','設備','其他'],
            datasets: [{
                data: [62,18,12,8],
                backgroundColor: [C.pri, C.acc, C.priH, C.ter],
                borderWidth: 0, spacing: 3,
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            cutout: '60%',
            plugins: { legend: { display: false } }
        }
    });
});
</script>
}
