@page
@using ReportCenter.Web.Models
@model ReportCenter.Web.Pages.ReportModel

@{
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var materialsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.MaterialRows.Select(r => new { material = r.Material, supplier = r.Supplier, qty = r.Qty, unitPrice = r.UnitPrice, amount = r.Amount, change = r.Change, category = r.Category, period = r.Period }),
        jsonOpts
    );
    var suppliers = Model.MaterialRows.Select(r => r.Supplier).Distinct().OrderBy(s => s).ToList();
    var suppliersJson = System.Text.Json.JsonSerializer.Serialize(suppliers, jsonOpts);
    var totalPages = (int)Math.Ceiling(Model.TotalRows / 20.0);
}

<div class="p-4 md:p-6 pb-10 max-w-[1200px]" x-data="reportPage()" x-init="init()">
    <!-- Breadcrumb -->
    <div class="text-[12px] text-txt-ter mb-3.5 flex items-center gap-1">
        <a href="/" class="hover:text-pri no-underline text-txt-ter cursor-pointer">首頁</a><span>/</span>
        <a href="/Department?dept=@Model.DeptId" class="hover:text-pri no-underline text-txt-ter cursor-pointer">@Model.Dept.Label</a><span>/</span>
        <span class="text-pri font-semibold">@Model.ReportName</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/Department?dept=@Model.DeptId" class="text-txt-ter flex no-underline">
                    <i data-lucide="chevron-left" class="w-[18px] h-[18px]"></i>
                </a>
                <h1 class="text-lg md:text-[20px] font-bold text-txt">@Model.ReportName</h1>
            </div>
            <div class="text-[12px] text-txt-ter pl-[26px]">@Model.Dept.Label ・ 成本分析 ・ 最後更新 2026/03/20 09:30</div>
        </div>
        <div class="flex gap-2">
            <span class="chip" @@click="toggleFav()">
                <svg class="w-3 h-3" :class="isFav ? 'text-[#f5a623] fill-[#f5a623]' : 'fill-none'" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span x-text="isFav ? '已收藏' : '收藏'"></span>
            </span>
            <!-- Excel 匯出功能暫時維持 toast 提示，未來改用後端套件實作實際下載 -->
            <span class="chip" @@click="exportData('excel')"><i data-lucide="file-spreadsheet" class="w-3 h-3"></i>Excel</span>
        </div>
    </div>

    <!-- Filter Bar (sticky) -->
    <div class="bg-white border border-bdr rounded-[10px] px-3 md:px-[18px] py-3 mb-5 flex flex-wrap gap-2 items-center shadow-sm sticky top-14 z-40">
        <!-- 日期 -->
        <div class="relative" @@click.outside="dateOpen = false">
            <span class="chip chip-active" @@click="dateOpen = !dateOpen">
                <span x-text="dateFilter"></span>
                <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
            </span>
            <div x-show="dateOpen" x-cloak class="absolute left-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[120px] z-50">
                <template x-for="d in ['2026/03','2026/02','2026/01','2025/12','2025/11','2025/10']">
                    <button :class="dateFilter === d ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                            class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                            @@click="dateFilter = d; dateOpen = false" x-text="d"></button>
                </template>
            </div>
        </div>
        <!-- 物料類別 -->
        <div class="relative" @@click.outside="materialOpen = false">
            <span class="chip" :class="materialCat !== '全部' && 'chip-active'" @@click="materialOpen = !materialOpen">
                物料類別: <span x-text="materialCat"></span>
                <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
            </span>
            <div x-show="materialOpen" x-cloak class="absolute left-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[130px] z-50">
                <template x-for="m in ['全部','原料','包材','設備','耗材']">
                    <button :class="materialCat === m ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                            class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                            @@click="materialCat = m; materialOpen = false" x-text="m"></button>
                </template>
            </div>
        </div>
        <!-- 供應商 -->
        <div class="relative" @@click.outside="supplierOpen = false">
            <span class="chip" :class="supplierFilter !== '全部' && 'chip-active'" @@click="supplierOpen = !supplierOpen">
                供應商: <span x-text="supplierFilter"></span>
                <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
            </span>
            <div x-show="supplierOpen" x-cloak class="absolute left-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[140px] z-50 max-h-[200px] overflow-y-auto">
                <button :class="supplierFilter === '全部' ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                        class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                        @@click="supplierFilter = '全部'; supplierOpen = false">全部</button>
                <template x-for="s in suppliers" :key="s">
                    <button :class="supplierFilter === s ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                            class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                            @@click="supplierFilter = s; supplierOpen = false" x-text="s"></button>
                </template>
            </div>
        </div>
        <div class="flex-1"></div>
        <span class="text-[12px] text-pri font-medium cursor-pointer" @@click="resetFilters()">重設篩選</span>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-4 mb-5">
        <div class="bg-white border border-bdr rounded-xl p-5 shadow-sm">
            <div class="flex flex-wrap justify-between items-center mb-2 gap-2">
                <span class="font-semibold text-sm text-txt">各類物料採購金額趨勢</span>
                <div class="flex gap-1">
                    <template x-for="ct in ['面積','長條','堆疊']">
                        <span class="chip" :class="chartType === ct && 'chip-active'"
                              @@click="chartType = ct; switchChartType(ct)" x-text="ct"></span>
                    </template>
                </div>
            </div>
            <div class="relative h-[240px]">
                <canvas id="costChart"></canvas>
            </div>
        </div>
        <div class="bg-white border border-bdr rounded-xl p-5 shadow-sm">
            <span class="font-semibold text-sm text-txt">採購佔比</span>
            <div class="relative h-[200px] mt-2">
                <canvas id="pieChart"></canvas>
            </div>
            <div class="flex gap-3 justify-center flex-wrap mt-3">
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-pri inline-block"></span>原料 62%</span>
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-acc inline-block"></span>包材 18%</span>
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-pri-hover inline-block"></span>設備 12%</span>
                <span class="flex items-center gap-1.5 text-[11px] text-txt-sec"><span class="w-2 h-2 rounded-full bg-txt-ter inline-block"></span>其他 8%</span>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 mb-5">
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "本月總採購" }, { "value", "$4.2M" }, { "trend", "-3.1" }, { "note", "vs 上月" } }' />
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "最大項目" }, { "value", "原料 62%" }, { "trend", "1.2" }, { "note", "" } }' />
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "供應商數" }, { "value", "47 家" }, { "trend", "6.8" }, { "note", "+3 家" } }' />
        <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", "平均單價" }, { "value", "-2.1%" }, { "trend", "-2.1" }, { "note", "" } }' />
    </div>

    <!-- Data Table -->
    <div class="bg-white border border-bdr rounded-xl overflow-hidden shadow-sm overflow-x-auto">
        <div class="flex justify-between items-center px-5 py-3.5 border-b border-bdr">
            <span class="font-semibold text-sm text-txt">明細資料</span>
            <span class="text-[11px] text-txt-ter">顯示 <span x-text="filteredRows.length"></span> / 共 <span x-text="totalRows"></span> 筆</span>
        </div>
        <div class="grid grid-cols-[2fr_1.5fr_1fr_0.8fr_1fr_0.8fr] min-w-[700px] px-5 py-2.5 bg-surface text-[11px] font-bold text-txt-ter uppercase tracking-wider">
            <span>物料名稱</span><span>供應商</span><span>數量</span><span>單價</span><span>金額</span><span>變化</span>
        </div>
        <template x-for="r in filteredRows" :key="r.material">
            <div class="grid grid-cols-[2fr_1.5fr_1fr_0.8fr_1fr_0.8fr] min-w-[700px] px-5 py-3 border-t border-bdr-light text-[13px] items-center">
                <span class="font-medium text-txt" x-text="r.material"></span>
                <span class="text-txt-sec" x-text="r.supplier"></span>
                <span x-text="r.qty"></span>
                <span x-text="r.unitPrice"></span>
                <span class="font-semibold text-pri" x-text="r.amount"></span>
                <span class="inline-flex items-center gap-1 font-semibold text-[12px]"
                      :class="r.change < 0 ? 'text-ok' : 'text-bad'">
                    <template x-if="r.change < 0"><i data-lucide="arrow-down-right" class="w-3 h-3"></i></template>
                    <template x-if="r.change >= 0"><i data-lucide="arrow-up-right" class="w-3 h-3"></i></template>
                    <span x-text="(r.change > 0 ? '+' : '') + r.change + '%'"></span>
                </span>
            </div>
        </template>
        <div x-show="filteredRows.length === 0" class="px-5 py-8 text-center text-txt-ter text-sm">
            找不到符合篩選條件的資料
        </div>
        <!-- Pagination -->
        <div class="px-5 py-3 border-t border-bdr flex justify-between items-center">
            <span class="text-[11px] text-txt-ter">每頁 20 筆</span>
            <div class="flex gap-0.5">
                @if (totalPages > 1)
                {
                    <a href="/Report?dept=@Model.DeptId&name=@System.Net.WebUtility.UrlEncode(Model.ReportName)&page=@(Math.Max(1, Model.CurrentPage - 1))"
                       class="px-2.5 py-1 text-[12px] rounded-md cursor-pointer text-txt-ter no-underline hover:bg-surface">◀</a>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <a href="/Report?dept=@Model.DeptId&name=@System.Net.WebUtility.UrlEncode(Model.ReportName)&page=@p"
                           class="px-2.5 py-1 text-[12px] rounded-md cursor-pointer no-underline @(p == Model.CurrentPage ? "bg-pri text-white font-semibold" : "text-txt-ter hover:bg-surface")">@p</a>
                    }
                    <a href="/Report?dept=@Model.DeptId&name=@System.Net.WebUtility.UrlEncode(Model.ReportName)&page=@(Math.Min(totalPages, Model.CurrentPage + 1))"
                       class="px-2.5 py-1 text-[12px] rounded-md cursor-pointer text-txt-ter no-underline hover:bg-surface">▶</a>
                }
                else
                {
                    <span class="px-2.5 py-1 text-[12px] rounded-md bg-pri text-white font-semibold">1</span>
                }
            </div>
        </div>
    </div>

</div>

@section Styles {
<style>
    .chip {
        font-size: 12px; padding: 5px 12px; border-radius: 6px; cursor: pointer;
        border: 1px solid #e2e8ea; background: white; color: #5c7576;
        white-space: nowrap; user-select: none; display: inline-flex; align-items: center; gap: 4px;
    }
    .chip-active {
        border-color: #005758; background: #e8f4f4; color: #005758; font-weight: 600;
    }
</style>
}

@section Scripts {
<script>
const _rp = {
    deptId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptId, jsonOpts)),
    reportName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportName, jsonOpts)),
    deptLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Dept.Label, jsonOpts)),
    reportId: @Model.ReportID
};
function reportPage() {
    return {
        chartType: '面積',
        dateFilter: '2026/03',
        materialCat: '全部',
        supplierFilter: '全部',
        dateOpen: false,
        materialOpen: false,
        supplierOpen: false,
        isFav: @(Model.IsFavorite ? "true" : "false"),
        allRows: [],
        suppliers: [],
        totalRows: @Model.TotalRows,

        init() {
            this.allRows = @Html.Raw(materialsJson);
            this.suppliers = @Html.Raw(suppliersJson);
            // 記錄最近瀏覽
            this.$store.recent.add(_rp.deptId, _rp.reportName, _rp.deptLabel);
            // 重新初始化 Lucide icons
            setTimeout(() => lucide.createIcons(), 100);
        },

        get filteredRows() {
            let list = this.allRows;
            list = list.filter(r => r.period === this.dateFilter);
            if (this.materialCat !== '全部') list = list.filter(r => r.category === this.materialCat);
            if (this.supplierFilter !== '全部') list = list.filter(r => r.supplier === this.supplierFilter);
            return list;
        },

        resetFilters() {
            this.dateFilter = '2026/03';
            this.materialCat = '全部';
            this.supplierFilter = '全部';
        },

        async toggleFav() {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Api/Favorite?handler=Toggle&reportId=' + _rp.reportId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token || '' }
                });
                const data = await res.json();
                if (data.success) {
                    this.isFav = data.isFavorite;
                    Alpine.store('toast').show(data.isFavorite ? '已加入收藏' : '已取消收藏');
                }
            } catch (e) {
                console.error('收藏切換失敗', e);
            }
        },

        exportData(format) {
            this.$store.toast.show('Excel 匯出功能開發中，敬請期待');
        }
    };
}

document.addEventListener('DOMContentLoaded', function() {
    const C = { pri: '#005758', acc: '#00b4b6', priH: '#006d6e', ter: '#94aeb0', borderL: '#eef2f3' };

    const chartData = {
        labels: ['10月','11月','12月','1月','2月','3月'],
        datasets: {
            raw: [2.5,2.7,2.9,2.6,2.8,2.6],
            packaging: [0.8,0.7,0.9,0.8,0.7,0.8],
            equipment: [0.6,0.5,0.7,0.4,0.6,0.5],
            other: [0.4,0.3,0.5,0.4,0.3,0.3]
        }
    };

    function makeDatasets(type) {
        const isBar = type === '長條' || type === '堆疊';
        const stacked = type === '堆疊';
        const fill = type === '面積' || stacked;
        return [
            { label: '原料', data: chartData.datasets.raw, borderColor: C.pri, backgroundColor: isBar ? C.pri : C.pri + '30', borderWidth: isBar ? 0 : 2, fill: fill && !isBar, tension: 0.4, pointRadius: 0, borderRadius: isBar ? 4 : 0 },
            { label: '包材', data: chartData.datasets.packaging, borderColor: C.acc, backgroundColor: isBar ? C.acc : C.acc + '30', borderWidth: isBar ? 0 : 2, fill: fill && !isBar, tension: 0.4, pointRadius: 0, borderRadius: isBar ? 4 : 0 },
            { label: '設備', data: chartData.datasets.equipment, borderColor: C.priH, backgroundColor: isBar ? C.priH : C.priH + '30', borderWidth: isBar ? 0 : 1.5, fill: stacked && !isBar, tension: 0.4, pointRadius: isBar ? 0 : 3, borderRadius: isBar ? 4 : 0 },
            { label: '其他', data: chartData.datasets.other, borderColor: C.ter, backgroundColor: isBar ? C.ter : C.ter + '30', borderWidth: isBar ? 0 : 1, borderDash: isBar ? undefined : [3,3], fill: stacked && !isBar, tension: 0.4, pointRadius: 0, borderRadius: isBar ? 4 : 0 }
        ];
    }

    const costCtx = document.getElementById('costChart');
    let costChart = new Chart(costCtx, {
        type: 'line',
        data: { labels: chartData.labels, datasets: makeDatasets('面積') },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { stacked: false, grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter } },
                y: { stacked: false, grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter, callback: v => v + 'M' } }
            }
        }
    });

    window.switchChartType = function(type) {
        costChart.destroy();
        const isBar = type === '長條' || type === '堆疊';
        const stacked = type === '堆疊';
        costChart = new Chart(costCtx, {
            type: isBar ? 'bar' : 'line',
            data: { labels: chartData.labels, datasets: makeDatasets(type) },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { stacked: stacked, grid: { color: C.borderL, display: !isBar }, ticks: { font: { size: 11 }, color: C.ter } },
                    y: { stacked: stacked, grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter, callback: v => v + 'M' } }
                }
            }
        });
    };

    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: ['原料','包材','設備','其他'],
            datasets: [{ data: [62,18,12,8], backgroundColor: [C.pri, C.acc, C.priH, C.ter], borderWidth: 0, spacing: 3 }]
        },
        options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { display: false } } }
    });
});
</script>
}
