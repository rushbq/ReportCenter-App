@using Microsoft.Extensions.Options
@using ReportCenter.Web.Models
@using ReportCenter.Web.Models.Settings
@using ReportCenter.Web.Services
@inject IReportService ReportService
@inject IPermissionService PermissionService
@inject IOptions<ReportBaseUrlSettings> BaseUrlOptions
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var currentDept = Context.Request.Query["dept"].ToString();
    var departments = ReportService.GetDepartments();
    var favorites = ReportService.GetUserFavorites();
    var baseUrls = BaseUrlOptions.Value;
    var totalCount = departments.Sum(d => d.Count);

    // 手機版側欄用：使用者與公司切換（桌面由頂欄呈現）
    var sidebarUser = ReportService.GetCurrentUser();
    var sidebarCompanies = ReportService.GetCompanies();
    var sidebarCookieCompanyId = Context.Request.Cookies["companyId"];
    var sidebarActiveCompanyId = !string.IsNullOrEmpty(sidebarCookieCompanyId) && sidebarCompanies.Any(c => c.Id == sidebarCookieCompanyId)
        ? sidebarCookieCompanyId
        : sidebarUser.CompanyId;
    var sidebarActiveCompanyName = sidebarCompanies.FirstOrDefault(c => c.Id == sidebarActiveCompanyId)?.ShortName ?? "台灣寶工";

    // 取收藏報表的詳細資訊供顯示（含完整連結）
    // 同一份報表可指派給多個部門，需依 reportId 去重，避免收藏清單重複顯示與計數膨脹
    var favReports = new List<object>();
    var seenFavIds = new HashSet<int>();
    foreach (var dept in departments)
    {
        var reports = ReportService.GetReports(dept.Id);
        foreach (var r in reports.Where(r => favorites.Contains(r.ReportID) && seenFavIds.Add(r.ReportID)))
        {
            var href = r.ReportTool switch
            {
                "SmartQuery" => baseUrls.SmartQuery + r.ReportCode,
                "SSRS" => baseUrls.SSRS + r.ReportCode,
                _ => $"/Report?dept={dept.Id}&name={Uri.EscapeDataString(r.Name)}"
            };
            var target = r.ReportTool == "Internal" ? "_self" : "_blank";
            favReports.Add(new { deptId = dept.Id, dept = dept.Label, name = r.Name, reportId = r.ReportID, href, target, useCompanyParam = r.UseCompanyParam });
        }
    }

    var jsonOpts = new System.Text.Json.JsonSerializerOptions
    {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
    var favReportsJson = System.Text.Json.JsonSerializer.Serialize(favReports, jsonOpts);
}

<aside class="w-[248px] min-w-[248px] bg-white border-r border-bdr flex flex-col sticky top-14 overflow-y-auto"
       style="height: calc(100vh - 56px)"
       x-data="{ showFavPanel: false, showRecentPanel: false }">
    <!-- 手機版：使用者 + 公司切換 (桌面版由頂欄呈現) -->
    <div class="md:hidden px-3.5 pt-3.5" x-data="{ companyOpen: false }" @@click.outside="companyOpen = false">
        <div class="flex items-center gap-2 px-2.5 py-2 rounded-lg bg-surface">
            <div class="w-8 h-8 rounded-full bg-pri-light flex items-center justify-center shrink-0">
                <i data-lucide="user" class="w-4 h-4 text-pri"></i>
            </div>
            <div class="flex-1 min-w-0 leading-tight">
                <div class="text-[13px] font-semibold text-txt truncate">@sidebarUser.Name</div>
                <div class="text-[11px] text-txt-ter truncate">@sidebarUser.NickName</div>
            </div>
        </div>
        @if (sidebarCompanies.Count > 1)
        {
            <div class="relative mt-2">
                <button @@click="companyOpen = !companyOpen"
                        class="w-full flex items-center gap-2 px-2.5 py-2 rounded-lg border border-bdr bg-white text-[13px] text-txt cursor-pointer">
                    <i data-lucide="building-2" class="w-4 h-4 text-pri shrink-0"></i>
                    <span class="flex-1 text-left font-medium truncate">@sidebarActiveCompanyName</span>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-txt-ter shrink-0" :class="companyOpen && 'rotate-180'"></i>
                </button>
                <div x-show="companyOpen" x-cloak x-transition
                     class="absolute left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 z-50">
                    @foreach (var company in sidebarCompanies)
                    {
                        <button @@click="document.cookie = 'companyId=@company.Id;path=/;max-age=31536000'; window.location.reload()"
                                class="menu-item flex items-center gap-2 @(company.Id == sidebarActiveCompanyId ? "bg-pri-light text-pri font-semibold" : "text-txt hover:bg-surface")">
                            <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
                            @company.ShortName
                        </button>
                    }
                </div>
            </div>
        }
        <div class="h-px bg-bdr mt-3"></div>
    </div>
    <!-- Home -->
    <div class="p-3.5 pb-1.5">
        <a href="/"
           class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] no-underline transition-all
                  @(currentPage == "/Index" ? "font-semibold text-pri bg-pri-light" : "text-txt hover:bg-[#f8fafa]")">
            <i data-lucide="home" class="w-4 h-4"></i>
            <span>首頁總覽</span>
        </a>
    </div>

    <!-- Section Label -->
    <div class="px-3.5 pt-2.5 pb-1">
        <div class="text-[10px] font-bold text-txt-ter uppercase tracking-wider pl-2.5">部門選單</div>
    </div>

    <!-- Departments (單純導覽；報表分類進入部門頁後以分頁呈現) -->
    <div class="px-3.5">
        @foreach (var d in departments)
        {
            var isActive = currentDept == d.Id && currentPage != "/Index";
            <a href="/Department?dept=@d.Id"
               class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] no-underline transition-all mb-px
                      @(isActive ? "font-semibold text-pri bg-pri-light" : "text-txt hover:bg-[#f8fafa]")">
                <i data-lucide="@d.Icon" class="w-4 h-4" style="stroke-width: @(isActive ? "2.2" : "1.8")"></i>
                <span class="flex-1">@d.Label</span>
                <span class="badge @(isActive ? "bg-pri/10 text-pri" : "bg-bdr-light text-txt-ter")">@d.Count</span>
            </a>
        }
    </div>

    <!-- Divider -->
    <div class="h-px bg-bdr mx-3.5 my-2.5"></div>

    <!-- 系統管理 (僅管理員可見) -->
    @{
        var currentUserId = ReportService.GetCurrentUser().Id;
        var isAdmin = PermissionService.IsAdmin(currentUserId);
    }
    @if (isAdmin)
    {
    <div class="px-3.5">
        <div class="text-[10px] font-bold text-txt-ter uppercase tracking-wider pl-2.5 mb-1">系統管理</div>
        @{
            var isAdminPage = currentPage?.Contains("Admin") == true;
            var isPermissionPage = currentPage?.Contains("Permission") == true;
        }
        <a href="/Admin"
           class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] no-underline transition-all
                  @(isAdminPage && !isPermissionPage ? "font-semibold text-pri bg-pri-light" : "text-txt hover:bg-[#f8fafa]")">
            <i data-lucide="settings" class="w-4 h-4"></i>
            <span>報表目錄管理</span>
        </a>
        <a href="/Admin/Permission"
           class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] no-underline transition-all
                  @(isPermissionPage ? "font-semibold text-pri bg-pri-light" : "text-txt hover:bg-[#f8fafa]")">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
            <span>權限管理</span>
        </a>
    </div>
    
    <!-- Divider -->
    <div class="h-px bg-bdr mx-3.5 my-2.5"></div>
    }

    <!-- Quick Access -->
    <div class="px-3.5" x-data="sidebarQuick()">
        <div class="text-[10px] font-bold text-txt-ter uppercase tracking-wider pl-2.5 mb-1">快捷存取</div>
        <!-- 我的收藏 -->
        <div class="relative">
            <button @@click="showFavPanel = !showFavPanel; showRecentPanel = false"
                    :class="showFavPanel && 'bg-pri-light text-pri'"
                    class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] text-txt hover:bg-[#f8fafa] cursor-pointer w-full border-0 bg-transparent text-left">
                <i data-lucide="star" class="w-4 h-4"></i>
                <span class="flex-1">我的收藏</span>
                <span class="text-[11px] text-pri font-semibold" x-text="favList.length"></span>
            </button>
            <!-- 收藏面板 -->
            <div x-show="showFavPanel" x-cloak x-transition class="ml-7 mb-1">
                <template x-if="favList.length === 0">
                    <div class="text-[11px] text-txt-ter py-2 px-2.5">尚無收藏報表</div>
                </template>
                <template x-for="f in favList" :key="f.reportId">
                    <a :href="getFavHref(f)" :target="f.target"
                       class="flex items-center gap-1.5 text-[11px] text-txt-sec px-2.5 py-[5px] rounded-[5px] no-underline hover:bg-pri-light hover:text-pri truncate">
                        <svg class="w-3 h-3 text-[#f5a623] fill-[#f5a623] shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <span class="truncate" x-text="f.name"></span>
                    </a>
                </template>
            </div>
        </div>
        <!-- 最近瀏覽 -->
        <div class="relative">
            <button @@click="showRecentPanel = !showRecentPanel; showFavPanel = false"
                    :class="showRecentPanel && 'bg-pri-light text-pri'"
                    class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] text-txt hover:bg-[#f8fafa] cursor-pointer w-full border-0 bg-transparent text-left">
                <i data-lucide="clock" class="w-4 h-4"></i>
                <span class="flex-1">最近瀏覽</span>
                <span class="text-[11px] text-pri font-semibold" x-text="$store.recent.count"></span>
            </button>
            <!-- 最近瀏覽面板 -->
            <div x-show="showRecentPanel" x-cloak x-transition class="ml-7 mb-1">
                <template x-if="$store.recent.count === 0">
                    <div class="text-[11px] text-txt-ter py-2 px-2.5">尚無瀏覽紀錄</div>
                </template>
                <template x-for="r in $store.recent.items.slice(0, 5)" :key="r.deptId + r.name">
                    <a :href="'/Report?dept=' + r.deptId + '&name=' + encodeURIComponent(r.name)"
                       class="flex items-center gap-1.5 text-[11px] text-txt-sec px-2.5 py-[5px] rounded-[5px] no-underline hover:bg-pri-light hover:text-pri truncate">
                        <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span class="truncate" x-text="r.name"></span>
                    </a>
                </template>
            </div>
        </div>
    </div>

    <div class="flex-1"></div>

    <!-- Footer -->
    <div class="px-6 py-3 border-t border-bdr text-[11px] text-txt-ter flex items-center gap-1.5">
        <div class="w-1.5 h-1.5 rounded-full bg-ok"></div>
        報表總數: @totalCount 份
    </div>
</aside>

<script>
function sidebarQuick() {
    return {
        favList: @Html.Raw(favReportsJson),
        showFavPanel: false,
        showRecentPanel: false,

        getFavHref(f) {
            if (!f.useCompanyParam) return f.href;
            const companyId = document.cookie.split('; ').find(c => c.startsWith('companyId='))?.split('=')[1] || '';
            const sep = f.href.includes('?') ? '&' : '?';
            return f.href + sep + 'dbs=' + encodeURIComponent(companyId);
        },

        init() {
            // 監聽收藏變更事件，動態更新 sidebar 收藏清單
            window.addEventListener('fav-changed', (e) => {
                const { reportId, isFavorite } = e.detail;
                if (!isFavorite) {
                    this.favList = this.favList.filter(f => f.reportId !== reportId);
                }
                // 新增收藏時需要完整資訊，透過 reload sidebar 部分取得
                // 簡化做法：頁面級別已有報表資訊，由觸發端提供
                if (isFavorite && e.detail.report) {
                    const r = e.detail.report;
                    this.favList.push(r);
                }
            });
        }
    };
}
</script>
