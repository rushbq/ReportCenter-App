@using Microsoft.Extensions.Options
@using ReportCenter.Web.Models
@using ReportCenter.Web.Models.Settings
@using ReportCenter.Web.Services
@inject IReportService ReportService
@inject IOptions<SiteSettings> SiteOptions
@inject IOptions<DataHubAuthSettings> DataHubAuthOptions
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SiteOptions.Value.Title</title>
    <!-- 簡體模式：轉換完成前先隱藏 body，避免繁體閃一下；3 秒後無論如何都顯示 -->
    <script>
        if (/(?:^|;\s*)rc_lang=zh-CN(?:;|$)/.test(document.cookie)) {
            document.documentElement.lang = 'zh-CN';
            document.documentElement.classList.add('zh-pending');
            setTimeout(() => document.documentElement.classList.remove('zh-pending'), 3000);
        }
    </script>
    <style>html.zh-pending body { visibility: hidden; }</style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png" />
    <!-- Lucide Icons -->
    <script src="~/lib/lucide/1.25.0/lucide.min.js" asp-append-version="true"></script>
    <!-- 登出時要呼叫 DataHubApi 撤銷共用的 Refresh Token；account 只在真正登入（非開發模擬身分）時才有，用來檢查是否已在其他站台登出 -->
    @{
        var rcAccount = User.Identity?.AuthenticationType == Microsoft.AspNetCore.Authentication.Cookies.CookieAuthenticationDefaults.AuthenticationScheme
            ? User.Identity.Name ?? ""
            : "";
    }
    <script>window.rcAuth = { apiBaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DataHubAuthOptions.Value.ApiBaseUrl)), account: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rcAccount)) };</script>
    <!-- 繁→簡逐字字典 (自架，不走 CDN；由 tools/gen-zh-t2s.py 產生，須在 site.js 之前載入) -->
    <script src="~/js/zh-t2s.js" asp-append-version="true"></script>
    <!-- Site JS (Alpine Store 初始化，須在 Alpine 之前載入) -->
    <script src="/js/site.js"></script>
    <!-- Alpine.js -->
    <script defer src="~/lib/alpinejs/3.15.12/cdn.min.js" asp-append-version="true"></script>
    <!-- Chart.js -->
    <script src="~/lib/chart.js/4.5.1/chart.umd.min.js" asp-append-version="true"></script>
    <!-- HTMX -->
    <script src="~/lib/htmx/2.0.4/htmx.min.js" asp-append-version="true"></script>
    <!-- Noto Sans TC (自架 Google Fonts 的 unicode-range 切片，瀏覽器只下載用到的字) -->
    <link rel="stylesheet" href="~/lib/fonts/noto-sans-tc/noto-sans-tc.css" asp-append-version="true" />
    <style>
        :root {
            --chart-export: #005758;
            --chart-tw: #c27600;
            --chart-cn: #6366f1;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Noto Sans TC', 'Microsoft YaHei', 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; }
        [x-cloak] { display: none !important; }
        /* 全站鍵盤焦點環（僅鍵盤操作時顯示，滑鼠點擊不觸發） */
        :focus-visible { outline: 2px solid #00b4b6; outline-offset: 2px; border-radius: 4px; }
        /* 尊重使用者「減少動態效果」偏好 */
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
        }
        /* 水平捲動容器隱藏捲軸（用於手機分類標籤等） */
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
    <!-- Tailwind CSS：由 Styles/input.css 於 dotnet build 時預先編譯；放在 inline style 之後以維持 utility 的覆寫順序 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface h-screen overflow-hidden flex flex-col"
      x-data="appShell()"
      @@keydown.escape.window="closeSidebar()">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_TopNav")

    <div class="flex min-h-0 flex-1 relative">
        <!-- Mobile sidebar overlay -->
        <div x-show="sidebarOpen" x-cloak
             @@click="closeSidebar()"
             class="fixed inset-0 bg-black/40 z-30 lg:hidden"
             x-transition:enter="transition-opacity ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"></div>

        <!-- Sidebar: hidden on mobile, visible on lg+ -->
        <div id="mobile-sidebar" x-ref="mobileSidebar"
             :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
             :inert="mobileViewport && !sidebarOpen"
             :aria-hidden="mobileViewport && !sidebarOpen"
             class="fixed top-14 left-0 z-40 lg:relative lg:top-0 lg:translate-x-0 transition-transform duration-200 ease-in-out">
            @await Html.PartialAsync("_Sidebar")
        </div>

        <main class="min-h-0 min-w-0 flex-1 overflow-y-auto">
            @RenderBody()
        </main>
    </div>

    <!-- 全站搜尋 Dialog -->
    <dialog id="globalSearchDialog"
            aria-labelledby="global-search-title"
            @@cancel.prevent="$store.search.close()"
            @@close="$store.search.onDialogClosed()"
            @@click.self="$store.search.close()"
            @@keydown.escape.prevent.stop="$store.search.close()"
            class="mx-auto mb-auto mt-[15vh] w-[calc(100%_-_2rem)] max-w-[520px] overflow-visible border-0 bg-transparent p-0 backdrop:bg-black/40">
        <div class="relative w-full rounded-xl border border-bdr bg-white shadow-2xl">
            <h2 id="global-search-title" class="sr-only">全站搜尋</h2>
            <div class="flex items-center gap-3 px-4 py-3 border-b border-bdr">
                <i data-lucide="search" class="w-5 h-5 text-txt-ter shrink-0"></i>
                <label for="globalSearchInput" class="sr-only">搜尋報表</label>
                <input id="globalSearchInput" type="text" placeholder="搜尋報表"
                       class="flex-1 bg-transparent border-0 outline-none text-[15px] text-txt placeholder:text-txt-ter"
                       x-model="$store.search.query"
                       @@input.debounce.200ms="$store.search.search()" />
                <kbd class="hidden text-[11px] text-txt-ter bg-surface border border-bdr rounded px-1.5 py-0.5 sm:inline">ESC</kbd>
                <button type="button" aria-label="關閉搜尋"
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md border-0 bg-transparent text-txt-ter hover:bg-surface hover:text-txt"
                        @@click="$store.search.close()">
                    <i data-lucide="x" class="h-5 w-5"></i>
                </button>
            </div>
            <div class="max-h-[360px] overflow-y-auto">
                <template x-if="$store.search.query && $store.search.results.length === 0">
                    <div class="px-4 py-8 text-center text-txt-ter text-sm">找不到符合的結果</div>
                </template>
                <template x-for="r in $store.search.results" :key="r.url">
                    <button class="w-full text-left px-4 py-3 flex items-start gap-3 hover:bg-surface border-0 bg-transparent cursor-pointer border-b border-bdr-light"
                            @@click="$store.search.go(r.url, r.target, r.reportId)">
                        <svg class="w-4 h-4 text-pri mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                        <div class="flex-1 min-w-0">
                            <div class="text-[13px] font-semibold text-txt truncate" x-text="r.name"></div>
                            <div class="text-[12px] text-txt-sec truncate" x-text="r.desc"></div>
                            <div class="flex items-center gap-2 mt-0.5 text-[12px]">
                                <span class="font-medium text-txt-sec" x-text="r.dept"></span>
                                <span class="badge text-[11px]" :class="catBadge(r.cat)" x-text="r.cat" x-show="r.cat"></span>
                            </div>
                        </div>
                    </button>
                </template>
            </div>
            <template x-if="!$store.search.query">
                <div class="px-4 py-3 text-[13px] text-txt-ter border-t border-bdr-light">
                    <span class="font-medium">提示：</span>輸入報表名稱、部門或分類來搜尋
                </div>
            </template>
        </div>
    </dialog>

    <!-- 全域 Toast -->
    <div x-data x-show="$store.toast.visible" x-cloak
         role="status" aria-live="polite" aria-atomic="true"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-4"
         :class="$store.toast.type === 'error' ? 'bg-bad' : 'bg-pri'"
         class="fixed bottom-6 left-4 right-4 text-white px-5 py-3 rounded-lg shadow-lg text-[13px] font-medium z-[200] flex items-center gap-2 sm:left-auto sm:right-6 sm:max-w-md">
        <template x-if="$store.toast.type !== 'error'">
            <svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22 4 12 14.01 9 11.01" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </template>
        <template x-if="$store.toast.type === 'error'">
            <svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6" stroke-linecap="round"/></svg>
        </template>
        <span x-text="$store.toast.msg"></span>
    </div>

    <!-- 搜尋索引注入 -->
    @{
        var jsonOpts = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
        var allDepts = ReportService.GetDepartments();
        var searchIndex = new List<object>();
        foreach (var dept in allDepts)
        {
            foreach (var report in ReportService.GetReports(dept.Id))
            {
                var url = ReportService.BuildReportUrl(report);
                searchIndex.Add(new { reportId = report.ReportID, name = report.Name, desc = report.Desc, dept = dept.Label, deptId = dept.Id, cat = report.Cat, reportTool = report.ReportTool, url, target = "_blank" });
            }
        }
    }
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            // 注入搜尋索引
            if (Alpine && Alpine.store) {
                Alpine.store('search').index = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(searchIndex, jsonOpts));
            }
        });
        document.addEventListener('htmx:afterSwap', () => lucide.createIcons());
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
