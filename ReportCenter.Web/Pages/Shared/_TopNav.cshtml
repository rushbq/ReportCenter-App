@using ReportCenter.Web.Services
@inject IReportService ReportService
@inject IHttpContextAccessor HttpContextAccessor
@{
    var user = ReportService.GetCurrentUser();
    var companies = ReportService.GetCompanies();
    var cookieCompanyId = HttpContextAccessor.HttpContext?.Request.Cookies["companyId"];
    var activeCompanyId = !string.IsNullOrEmpty(cookieCompanyId) && companies.Any(c => c.Id == cookieCompanyId)
        ? cookieCompanyId
        : user.CompanyId;
    var defaultCompany = companies.FirstOrDefault(c => c.Id == activeCompanyId)?.ShortName ?? "台灣寶工";
}
<nav class="h-14 bg-pri flex items-center px-3 md:px-5 gap-2 md:gap-3 text-white sticky top-0 z-50 shadow-[0_2px_8px_rgba(0,87,88,0.15)]"
     x-data="{ mobileSearch: false, companyOpen: false, selectedCompany: '@defaultCompany' }">
    <!-- Mobile hamburger -->
    <button @@click="sidebarOpen = !sidebarOpen" class="lg:hidden p-1.5 rounded-md bg-white/10 border border-white/10 cursor-pointer">
        <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 no-underline text-white shrink-0">
        <img src="/images/logo.png" alt="ReportCenter" class="h-8 w-auto" />
    </a>
    <!-- Company Selector -->
    <div class="hidden md:block relative" @@click.outside="companyOpen = false">
        <button @@click="companyOpen = !companyOpen"
                class="flex bg-white/10 rounded-md px-3.5 py-1.5 text-[13px] items-center gap-2 cursor-pointer border border-white/[0.12] text-white">
            <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
            <span class="font-semibold" x-text="selectedCompany"></span>
            <i data-lucide="chevron-down" class="w-3 h-3 opacity-50 transition-transform" :class="companyOpen && 'rotate-180'"></i>
        </button>
        <div x-show="companyOpen" x-cloak
             x-transition:enter="transition ease-out duration-100"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-75"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95"
             class="absolute top-full left-0 mt-1.5 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[160px] z-50">
            @foreach (var company in companies)
            {
                <button @@click="document.cookie = 'companyId=@company.Id;path=/;max-age=31536000'; selectedCompany = '@company.ShortName'; companyOpen = false; window.location.reload()"
                        :class="selectedCompany === '@company.ShortName' ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                        class="w-full text-left px-4 py-2 text-[13px] flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                    <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
                    @company.ShortName
                </button>
            }
        </div>
    </div>
    <!-- Search (desktop) — 點擊開啟全站搜尋 Modal -->
    <button @@click="$store.search.toggle()"
            class="hidden sm:flex flex-1 max-w-[400px] bg-white/[0.08] rounded-lg px-3.5 h-9 items-center gap-2.5 border border-white/10 ml-2 cursor-pointer text-white">
        <i data-lucide="search" class="w-3.5 h-3.5 opacity-50"></i>
        <span class="opacity-40 text-[13px]">搜尋報表、儀表板…</span>
        <span class="ml-auto text-[10px] opacity-35 border border-white/20 rounded px-1.5 py-0.5">⌘K</span>
    </button>
    <div class="flex-1"></div>
    <!-- Right -->
    <div class="flex items-center gap-3 md:gap-4">
        <!-- Mobile search icon -->
        <button @@click="$store.search.toggle()" class="sm:hidden cursor-pointer p-1 bg-transparent border-0 text-white">
            <i data-lucide="search" class="w-[18px] h-[18px] opacity-80"></i>
        </button>
        <!-- User Info -->
        <div class="flex items-center gap-2 cursor-pointer">
            <div class="hidden md:flex flex-col leading-tight">
                <span class="text-[12px] font-semibold">@user.Name</span>
                <span class="text-[10px] opacity-60">@user.DeptName</span>
            </div>
        </div>
    </div>

</nav>
