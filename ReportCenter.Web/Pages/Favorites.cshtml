@page
@model ReportCenter.Web.Pages.FavoritesModel

@{
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var favoritesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Favorites.Select(f => new {
            reportId = f.Report.ReportID, name = f.Report.Name, desc = f.Report.Desc, cat = f.Report.Cat,
            deptId = f.DeptId, dept = f.DeptLabel, href = f.Href
        }), jsonOpts
    );
    var groupsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Groups.Select(g => new { deptId = g.DeptId, label = g.Label }), jsonOpts
    );
}

<div class="page-container" x-data="favoritesPage()" x-init="init()">
    <!-- Breadcrumb -->
    <div class="text-[12px] text-txt-ter mb-3.5">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a> /
        <span class="text-pri font-semibold">我的收藏</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[10px] bg-amber-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-star fill-star" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div>
                <h1 class="text-lg md:text-[20px] font-bold text-txt">我的收藏</h1>
                <div class="text-[12px] text-txt-ter mt-0.5" aria-live="polite">共 <span x-text="activeCount"></span> 份收藏報表</div>
            </div>
        </div>
        <div x-show="items.length > 0" class="bg-white border border-bdr rounded-lg px-3 py-[7px] flex items-center gap-1.5 w-full sm:w-[240px]">
            <i data-lucide="search" class="w-3.5 h-3.5 text-txt-ter"></i>
            <input type="text" placeholder="搜尋收藏報表…" aria-label="搜尋收藏報表" x-model="searchQuery"
                   class="flex-1 bg-transparent border-0 outline-none text-[12px] text-txt placeholder:text-txt-ter w-full" />
            <button x-show="searchQuery" @@click="searchQuery = ''" aria-label="清除搜尋" class="bg-transparent border-0 cursor-pointer p-0">
                <i data-lucide="x" class="w-3 h-3 text-txt-ter"></i>
            </button>
        </div>
    </div>

    @if (Model.Favorites.Count == 0)
    {
        <!-- 尚無收藏 -->
        <div class="bg-white border border-dashed border-bdr rounded-xl text-center py-14 px-6">
            <svg class="w-10 h-10 text-txt-ter mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <div class="text-txt text-sm font-semibold">還沒有收藏任何報表</div>
            <div class="text-txt-ter text-[12px] mt-1.5">到左側部門報表頁，點報表卡片右上角的 ☆ 即可加入收藏</div>
        </div>
    }
    else
    {
        <!-- 部門篩選 (單列水平捲動) -->
        <div class="flex gap-2 mb-4 overflow-x-auto no-scrollbar -mx-4 px-4 md:mx-0 md:px-0 md:flex-wrap">
            <button type="button" @@click="dept = ''" :aria-pressed="dept === ''"
                    :class="dept === '' ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr hover:border-pri/40'"
                    class="shrink-0 whitespace-nowrap px-3 py-1.5 text-[12px] cursor-pointer rounded-full border flex items-center gap-1.5 transition-colors">
                全部
                <span :class="dept === '' ? 'bg-white/20 text-white' : 'bg-bdr-light text-txt-sec'"
                      class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full" x-text="deptCount('')"></span>
            </button>
            <template x-for="g in groups" :key="g.deptId">
                <button type="button" @@click="dept = g.deptId" :aria-pressed="dept === g.deptId"
                        :class="dept === g.deptId ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr hover:border-pri/40'"
                        class="shrink-0 whitespace-nowrap px-3 py-1.5 text-[12px] cursor-pointer rounded-full border flex items-center gap-1.5 transition-colors">
                    <span x-text="g.label"></span>
                    <span :class="dept === g.deptId ? 'bg-white/20 text-white' : 'bg-bdr-light text-txt-sec'"
                          class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full" x-text="deptCount(g.deptId)"></span>
                </button>
            </template>
        </div>

        <!-- 篩選無結果 -->
        <div x-show="visibleGroups.length === 0" x-cloak class="text-center py-12">
            <i data-lucide="search-x" class="w-10 h-10 text-txt-ter mx-auto mb-3"></i>
            <div class="text-txt-sec text-sm">找不到符合條件的收藏報表</div>
            <button @@click="searchQuery = ''; dept = ''"
                    class="mt-3 text-[13px] text-pri font-medium cursor-pointer bg-transparent border-0 underline">清除篩選</button>
        </div>

        <!-- 依部門分組的卡片 -->
        <div class="space-y-6">
            <template x-for="g in visibleGroups" :key="g.deptId">
                <section>
                    <div class="flex items-center gap-2 mb-2.5">
                        <h2 class="text-[13px] font-bold text-txt" x-text="g.label"></h2>
                        <span class="text-[11px] text-txt-ter" x-text="g.items.length + ' 份'"></span>
                        <div class="flex-1 h-px bg-bdr ml-1"></div>
                        <a :href="'/Department?dept=' + g.deptId"
                           class="text-[11px] text-txt-ter no-underline hover:text-pri whitespace-nowrap">前往部門 →</a>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                        <template x-for="r in g.items" :key="r.reportId">
                            <a :href="r.href" target="_blank" rel="noopener"
                               :aria-label="`${r.name}（另開新分頁）`"
                               :data-report-id="r.reportId" data-report-source="favorite"
                               :class="isFav(r.reportId) ? 'opacity-100' : 'opacity-60'"
                               class="group bg-white border border-bdr rounded-[10px] p-3.5 flex flex-col gap-1.5 shadow-sm no-underline
                                      hover:shadow-md hover:border-pri hover:-translate-y-0.5 transition-all duration-200">
                                <div class="flex items-center justify-between gap-2 min-h-[22px]">
                                    <span class="badge" :class="window.catBadge(r.cat)" x-text="r.cat" x-show="r.cat"></span>
                                    <span role="button" tabindex="0" :aria-label="isFav(r.reportId) ? '取消收藏 ' + r.name : '重新收藏 ' + r.name"
                                          :aria-pressed="isFav(r.reportId)"
                                          :title="isFav(r.reportId) ? '取消收藏' : '重新收藏'"
                                          class="ml-auto -my-1.5 -mr-1.5 p-2 rounded-full cursor-pointer hover:bg-surface transition-colors"
                                          @@click.prevent.stop="toggleFav(r)"
                                          @@keydown.enter.prevent.stop="toggleFav(r)"
                                          @@keydown.space.prevent.stop="toggleFav(r)">
                                        <svg class="w-3.5 h-3.5 transition-transform hover:scale-110" :class="isFav(r.reportId) ? 'text-star fill-star' : 'text-txt-ter fill-none'" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    </span>
                                </div>
                                <div class="flex items-start gap-1.5">
                                    <span class="text-[14px] font-semibold text-txt leading-snug flex-1 group-hover:text-pri transition-colors" x-text="r.name"></span>
                                    <svg class="w-3.5 h-3.5 text-txt-ter shrink-0 mt-0.5 group-hover:text-pri transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                                </div>
                                <span class="text-[12px] text-txt-sec leading-relaxed line-clamp-2" x-show="r.desc" x-text="r.desc"></span>
                            </a>
                        </template>
                    </div>
                </section>
            </template>
        </div>
    }
</div>

@section Scripts {
<script>
function favoritesPage() {
    return {
        items: [],
        groups: [],
        // 本頁取消收藏的報表仍保留在畫面上 (淡化、空心星)，誤按可直接再點一次復原
        favIds: [],
        dept: '',
        searchQuery: '',
        busyId: null,

        init() {
            this.items = @Html.Raw(favoritesJson);
            this.groups = @Html.Raw(groupsJson);
            this.favIds = this.items.map(r => r.reportId);
        },

        get activeCount() {
            return this.favIds.length;
        },

        isFav(reportId) {
            return this.favIds.includes(reportId);
        },

        searchFiltered() {
            const q = this.searchQuery.trim().toLowerCase();
            if (!q) return this.items;
            return this.items.filter(r =>
                r.name.toLowerCase().includes(q) ||
                (r.desc || '').toLowerCase().includes(q) ||
                (r.cat || '').toLowerCase().includes(q) ||
                r.dept.toLowerCase().includes(q)
            );
        },

        deptCount(deptId) {
            const list = this.searchFiltered();
            return deptId ? list.filter(r => r.deptId === deptId).length : list.length;
        },

        // 順序沿用後端 (部門依側欄順序，部門內依自訂排序 → 報表名稱)
        get visibleGroups() {
            const list = this.searchFiltered();
            return this.groups
                .filter(g => !this.dept || g.deptId === this.dept)
                .map(g => ({ ...g, items: list.filter(r => r.deptId === g.deptId) }))
                .filter(g => g.items.length > 0);
        },

        async toggleFav(r) {
            if (this.busyId !== null) return;
            this.busyId = r.reportId;
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Api/Favorite?handler=Toggle&reportId=' + r.reportId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token || '' }
                });
                const data = await res.json();
                if (!data.success) {
                    Alpine.store('toast').show(data.message || '收藏切換失敗', 'error');
                    return;
                }
                if (data.isFavorite) {
                    this.favIds.push(r.reportId);
                    Alpine.store('toast').show('已重新加入收藏');
                } else {
                    this.favIds = this.favIds.filter(id => id !== r.reportId);
                    Alpine.store('toast').show('已取消收藏，再點一次星號可復原');
                }
                window.dispatchEvent(new CustomEvent('fav-changed', { detail: { reportId: r.reportId, isFavorite: data.isFavorite } }));
            } catch (e) {
                console.error('收藏切換失敗', e);
                Alpine.store('toast').show('收藏切換失敗，請稍後再試', 'error');
            } finally {
                this.busyId = null;
            }
        }
    };
}
</script>
}
