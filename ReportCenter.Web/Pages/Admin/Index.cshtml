@page
@using System.Text.Json
@using System.Text.Encodings.Web
@model ReportCenter.Web.Pages.Admin.IndexModel

@if (Model.AccessDenied)
{
    <partial name="_AccessDenied" />
    return;
}

@{
    // 序列化選項：避免中文轉義為 \uXXXX
    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    // 相依性分析資料由 PageModel.BuildDependencyAnalysis() 預先計算
    var depAnalysisJson = JsonSerializer.Serialize(
        Model.DepAnalysis.Select(g => new { name = g.Name, reports = g.Reports }),
        jsonOpts);
}

<div class="page-container"
     x-data="adminDashPage()" x-init="init()">

    <!-- 麵包屑 -->
    <div class="flex items-center gap-1.5 text-[12px] text-txt-ter mb-4">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <span class="text-txt font-medium">系統管理</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div>
            <h1 class="text-[20px] md:text-[22px] font-bold text-txt">報表管理總覽</h1>
            <div class="text-[12px] text-txt-ter mt-1">報表清冊統計與部門使用分析</div>
        </div>
        <a href="/Admin/Catalog"
           class="inline-flex items-center gap-2 px-4 py-2 bg-pri text-white rounded-lg text-[13px] font-medium no-underline hover:bg-pri-hover transition-colors">
            <i data-lucide="settings" class="w-4 h-4"></i>
            管理報表目錄
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
    </div>

    <!-- KPI 卡片 -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 mb-5">
        <!-- 報表總數 -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm">
            <div class="text-[12px] text-txt-sec mb-1">報表總數</div>
            <div class="text-[26px] font-bold text-pri">@Model.Stats.TotalReports</div>
            <div class="text-[11px] text-txt-ter mt-1">
                啟用 <span class="text-ok font-semibold">@Model.Stats.ActiveReports</span>
                ・停用 <span class="text-bad font-semibold">@Model.Stats.InactiveReports</span>
            </div>
        </div>
        <!-- Internal -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm border-t-2 border-t-emerald-500">
            <div class="flex items-center gap-1.5 text-[12px] text-txt-sec mb-1">
                <i data-lucide="monitor" class="w-3.5 h-3.5 text-emerald-600"></i> 內部報表
            </div>
            <div class="text-[26px] font-bold text-emerald-700">@Model.Stats.InternalCount</div>
            <div class="text-[11px] text-txt-ter mt-1">開發於本系統</div>
        </div>
        <!-- SmartQuery -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm border-t-2 border-t-amber-500">
            <div class="flex items-center gap-1.5 text-[12px] text-txt-sec mb-1">
                <i data-lucide="external-link" class="w-3.5 h-3.5 text-amber-600"></i> SmartQuery
            </div>
            <div class="text-[26px] font-bold text-amber-700">@Model.Stats.SmartQueryCount</div>
            <div class="text-[11px] text-txt-ter mt-1">外部查詢報表</div>
        </div>
        <!-- SSRS -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm border-t-2 border-t-indigo-500">
            <div class="flex items-center gap-1.5 text-[12px] text-txt-sec mb-1">
                <i data-lucide="file-bar-chart" class="w-3.5 h-3.5 text-indigo-600"></i> SSRS 報表
            </div>
            <div class="text-[26px] font-bold text-indigo-700">@Model.Stats.SsrsCount</div>
            <div class="text-[11px] text-txt-ter mt-1">SQL Server Reporting</div>
        </div>
    </div>

    <!-- 部門使用矩陣（台灣 / 上海雙欄） -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm mb-5">
        <div class="px-5 py-3.5 border-b border-bdr flex items-center gap-2">
            <i data-lucide="layout-grid" class="w-4 h-4 text-pri"></i>
            <h2 class="text-[14px] font-semibold text-txt">部門使用矩陣</h2>
            <span class="ml-auto inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface text-[10px] text-txt-ter">
                <i data-lucide="info" class="w-3 h-3"></i>
                僅顯示 appsettings DepartmentDisplay 設定的部門
            </span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 divide-y lg:divide-y-0 lg:divide-x divide-bdr">
            <!-- 台灣寶工 -->
            <div class="p-4">
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-2.5 h-2.5 rounded-full bg-pri"></span>
                    <span class="text-[13px] font-bold text-txt">台灣寶工</span>
                    <span class="text-[11px] text-txt-ter">@Model.Stats.DeptUsagesTW.Count 個部門</span>
                </div>
                @if (Model.Stats.DeptUsagesTW.Count == 0)
                {
                    <div class="text-center py-6 text-[12px] text-txt-ter">尚無部門報表指派</div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var du in Model.Stats.DeptUsagesTW)
                        {
                            <div class="p-3 rounded-lg bg-surface/60 border border-bdr-light">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-[12px] font-semibold text-txt">@du.DeptName</span>
                                    <span class="inline-flex items-center justify-center min-w-[22px] px-1.5 py-0.5 rounded-full bg-pri/10 text-pri text-[10px] font-bold">@du.Reports.Count</span>
                                </div>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var r in du.Reports)
                                    {
                                        var chipCls = r.ReportTool switch
                                        {
                                            "Internal" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                            "SmartQuery" => "bg-amber-50 text-amber-700 border-amber-200",
                                            "SSRS" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                            _ => "bg-white text-txt-sec border-bdr"
                                        };
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border @chipCls">@r.ReportName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- 上海寶工 -->
            <div class="p-4">
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    <span class="text-[13px] font-bold text-txt">上海寶工</span>
                    <span class="text-[11px] text-txt-ter">@Model.Stats.DeptUsagesSH.Count 個部門</span>
                </div>
                @if (Model.Stats.DeptUsagesSH.Count == 0)
                {
                    <div class="text-center py-6 text-[12px] text-txt-ter">尚無部門報表指派</div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var du in Model.Stats.DeptUsagesSH)
                        {
                            <div class="p-3 rounded-lg bg-surface/60 border border-bdr-light">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-[12px] font-semibold text-txt">@du.DeptName</span>
                                    <span class="inline-flex items-center justify-center min-w-[22px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-700 text-[10px] font-bold">@du.Reports.Count</span>
                                </div>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var r in du.Reports)
                                    {
                                        var chipCls = r.ReportTool switch
                                        {
                                            "Internal" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                            "SmartQuery" => "bg-amber-50 text-amber-700 border-amber-200",
                                            "SSRS" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                            _ => "bg-white text-txt-sec border-bdr"
                                        };
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border @chipCls">@r.ReportName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 孤立報表 -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm mb-5">
        <div class="px-5 py-3.5 border-b border-bdr flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-bad"></i>
            <h2 class="text-[14px] font-semibold text-txt">未指派部門的報表</h2>
            @if (Model.Stats.OrphanCount > 0)
            {
                <span class="ml-auto px-2 py-0.5 rounded-full bg-bad/10 text-bad text-[11px] font-semibold">@Model.Stats.OrphanCount</span>
            }
        </div>
        <div class="p-5">
            @if (Model.Stats.OrphanItems.Count == 0)
            {
                <div class="text-center py-8">
                    <i data-lucide="check-circle" class="w-8 h-8 text-ok mx-auto mb-2"></i>
                    <div class="text-[13px] text-txt-sec">所有報表皆已指派部門</div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                    @foreach (var orphan in Model.Stats.OrphanItems)
                    {
                        var toolCls = orphan.ReportTool switch
                        {
                            "Internal" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                            "SmartQuery" => "bg-amber-50 text-amber-700 border-amber-200",
                            "SSRS" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                            _ => "bg-surface text-txt-sec border-bdr"
                        };
                        <div class="flex items-center gap-3 p-3 rounded-lg border border-bdr hover:border-bad/30 transition-colors">
                            <div class="flex-1 min-w-0">
                                <div class="text-[13px] font-medium text-txt truncate">@orphan.ReportName</div>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border @toolCls">@orphan.ReportTool</span>
                                    @if (!orphan.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] text-bad">
                                            <span class="w-1.5 h-1.5 rounded-full bg-bad"></span>停用
                                        </span>
                                    }
                                </div>
                            </div>
                            <a href="/Admin/Catalog?edit=@orphan.ReportID" class="text-[11px] text-pri hover:underline no-underline whitespace-nowrap">指派部門</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 最近異動 -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm mb-5">
        <div class="px-5 py-3.5 border-b border-bdr flex items-center gap-2">
            <i data-lucide="clock" class="w-4 h-4 text-pri"></i>
            <h2 class="text-[14px] font-semibold text-txt">最近異動</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-[13px]">
                <thead>
                    <tr class="bg-surface text-txt-sec text-[11px]">
                        <th class="px-5 py-2.5 text-left font-semibold">報表名稱</th>
                        <th class="px-3 py-2.5 text-center font-semibold">工具類型</th>
                        <th class="px-3 py-2.5 text-center font-semibold">狀態</th>
                        <th class="px-3 py-2.5 text-center font-semibold">部門</th>
                        <th class="px-5 py-2.5 text-right font-semibold">異動日期</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Stats.RecentItems)
                    {
                        var toolCls = r.ReportTool switch
                        {
                            "Internal" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                            "SmartQuery" => "bg-amber-50 text-amber-700 border-amber-200",
                            "SSRS" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                            _ => "bg-surface text-txt-sec border-bdr"
                        };
                        <tr class="border-t border-bdr-light hover:bg-surface/50 transition-colors">
                            <td class="px-5 py-3">
                                <a href="/Admin/Catalog?edit=@r.ReportID" class="font-medium text-txt no-underline hover:text-pri transition-colors">@r.ReportName</a>
                            </td>
                            <td class="px-3 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border @toolCls">@r.ReportTool</span>
                            </td>
                            <td class="px-3 py-3 text-center">
                                @if (r.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 text-[11px] text-ok"><span class="w-1.5 h-1.5 rounded-full bg-ok"></span>啟用</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-[11px] text-bad"><span class="w-1.5 h-1.5 rounded-full bg-bad"></span>停用</span>
                                }
                            </td>
                            <td class="px-3 py-3 text-center text-[11px] text-txt-sec">
                                @if (r.Departments.Count == 0)
                                {
                                    <span class="text-bad">未指派</span>
                                }
                                else
                                {
                                    @string.Join("、", r.Departments.Select(d => d.DeptName))
                                }
                            </td>
                            <td class="px-5 py-3 text-right text-[12px] text-txt-sec">
                                @((r.ModifyDate ?? r.CreateDate).ToString("yyyy/MM/dd"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 相依性分析 -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm">
        <button @@click="depOpen = !depOpen"
                class="w-full px-5 py-3.5 border-0 bg-transparent flex items-center gap-2 cursor-pointer text-left hover:bg-surface/50 transition-colors rounded-xl">
            <i data-lucide="git-branch" class="w-4 h-4 text-pri"></i>
            <h2 class="text-[14px] font-semibold text-txt flex-1">相依性分析</h2>
            <i data-lucide="chevron-down" class="w-4 h-4 text-txt-ter transition-transform" :class="depOpen && 'rotate-180'"></i>
        </button>
        <div x-show="depOpen" x-cloak x-transition class="px-5 pb-5 border-t border-bdr">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">
                <template x-for="dep in depAnalysis" :key="dep.name">
                    <div class="p-3 rounded-lg bg-surface border border-bdr-light">
                        <div class="text-[12px] font-mono font-semibold text-pri mb-2" x-text="dep.name"></div>
                        <div class="flex flex-wrap gap-1">
                            <template x-for="r in dep.reports" :key="r">
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-white border border-bdr text-txt-sec" x-text="r"></span>
                            </template>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function adminDashPage() {
    return {
        depOpen: false,
        depAnalysis: [],
        init() {
            this.depAnalysis = @Html.Raw(depAnalysisJson);
        }
    };
}
</script>
}
