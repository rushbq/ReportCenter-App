@page
@model ReportCenter.Web.Pages.Admin.IndexModel

@if (Model.AccessDenied)
{
    <partial name="_AccessDenied" />
    return;
}

@* x-data 為部門矩陣的「展開/收合全部」提供 $dispatch 所需的 Alpine scope *@
<div class="page-container" x-data>

    <!-- 麵包屑 -->
    <div class="flex items-center gap-1.5 text-[12px] text-txt-ter mb-4">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <span class="text-txt font-medium">系統管理</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div>
            <h1 class="text-[20px] md:text-[22px] font-bold text-txt">報表管理總覽</h1>
            <div class="text-[12px] text-txt-ter mt-1">報表清冊統計與部門使用分析</div>
        </div>
        <a href="/Admin/Catalog"
           class="inline-flex items-center gap-2 px-4 py-2 bg-pri text-white rounded-lg text-[13px] font-medium no-underline hover:bg-pri-hover transition-colors">
            <i data-lucide="settings" class="w-4 h-4"></i>
            管理報表目錄
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
    </div>

    <!-- KPI 卡片 -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 mb-5">
        <!-- 報表總數 -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[12px] text-txt-sec">報表總數</span>
                <span class="w-7 h-7 rounded-lg bg-pri-light flex items-center justify-center shrink-0">
                    <i data-lucide="library" class="w-4 h-4 text-pri"></i>
                </span>
            </div>
            <div class="text-[26px] font-bold text-pri leading-none">@Model.Stats.TotalReports</div>
            <div class="text-[11px] text-txt-ter mt-1.5">
                啟用 <span class="text-ok font-semibold">@Model.Stats.ActiveReports</span>
                ・停用 <span class="text-bad font-semibold">@Model.Stats.InactiveReports</span>
            </div>
        </div>
        <!-- Internal -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[12px] text-txt-sec">內部報表</span>
                <span class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center shrink-0">
                    <i data-lucide="monitor" class="w-4 h-4 text-emerald-600"></i>
                </span>
            </div>
            <div class="text-[26px] font-bold text-emerald-700 leading-none">@Model.Stats.InternalCount</div>
            <div class="text-[11px] text-txt-ter mt-1.5">開發於本系統</div>
        </div>
        <!-- SmartQuery -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[12px] text-txt-sec">SmartQuery</span>
                <span class="w-7 h-7 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
                    <i data-lucide="external-link" class="w-4 h-4 text-amber-600"></i>
                </span>
            </div>
            <div class="text-[26px] font-bold text-amber-700 leading-none">@Model.Stats.SmartQueryCount</div>
            <div class="text-[11px] text-txt-ter mt-1.5">外部查詢報表</div>
        </div>
        <!-- SSRS -->
        <div class="bg-white rounded-xl border border-bdr p-4 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[12px] text-txt-sec">SSRS 報表</span>
                <span class="w-7 h-7 rounded-lg bg-indigo-50 flex items-center justify-center shrink-0">
                    <i data-lucide="file-bar-chart" class="w-4 h-4 text-indigo-600"></i>
                </span>
            </div>
            <div class="text-[26px] font-bold text-indigo-700 leading-none">@Model.Stats.SsrsCount</div>
            <div class="text-[11px] text-txt-ter mt-1.5">SQL Server Reporting</div>
        </div>
    </div>

    <!-- 部門使用矩陣（台灣 / 上海雙欄） -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm mb-5">
        <div class="px-5 py-3.5 border-b border-bdr flex flex-wrap items-center gap-2">
            <i data-lucide="layout-grid" class="w-4 h-4 text-pri"></i>
            <h2 class="text-[14px] font-semibold text-txt">部門使用矩陣</h2>
            <div class="ml-auto flex items-center gap-2">
                <button type="button" @@click="$dispatch('dept-toggle-all', { open: true })"
                        class="inline-flex items-center gap-1 px-2 py-1 rounded-md border border-bdr bg-white text-[11px] text-txt-sec hover:text-pri hover:border-pri/40 transition-colors cursor-pointer">
                    <i data-lucide="chevrons-down" class="w-3 h-3"></i>展開全部
                </button>
                <button type="button" @@click="$dispatch('dept-toggle-all', { open: false })"
                        class="inline-flex items-center gap-1 px-2 py-1 rounded-md border border-bdr bg-white text-[11px] text-txt-sec hover:text-pri hover:border-pri/40 transition-colors cursor-pointer">
                    <i data-lucide="chevrons-up" class="w-3 h-3"></i>收合全部
                </button>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface text-[10px] text-txt-ter">
                    <i data-lucide="info" class="w-3 h-3"></i>
                    僅顯示 appsettings DepartmentDisplay 設定的部門
                </span>
            </div>
        </div>
        <div class="px-5 py-2 border-b border-bdr-light flex items-center gap-4 text-[10px] text-txt-ter">
            <span class="font-medium text-txt-sec">類型</span>
            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Internal</span>
            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>SmartQuery</span>
            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>SSRS</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 divide-y lg:divide-y-0 lg:divide-x divide-bdr">
            <!-- 台灣寶工 -->
            <div class="p-4">
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-2.5 h-2.5 rounded-full bg-pri"></span>
                    <span class="text-[13px] font-bold text-txt">台灣寶工</span>
                    <span class="text-[11px] text-txt-ter">@Model.Stats.DeptUsagesTW.Count 個部門</span>
                </div>
                @if (Model.Stats.DeptUsagesTW.Count == 0)
                {
                    <div class="text-center py-6 text-[12px] text-txt-ter">尚無部門報表指派</div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var du in Model.Stats.DeptUsagesTW)
                        {
                            <div class="rounded-lg bg-surface/60 border border-bdr-light overflow-hidden"
                                 x-data="{ open: false }" @@dept-toggle-all.window="open = $event.detail.open">
                                <button type="button" @@click="open = !open"
                                        class="w-full flex items-center justify-between gap-2 px-3 py-2.5 border-0 bg-transparent cursor-pointer text-left hover:bg-pri/5 transition-colors">
                                    <span class="flex items-center gap-2 min-w-0">
                                        <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-txt-ter shrink-0 transition-transform" :class="open && 'rotate-90'"></i>
                                        <span class="text-[12px] font-semibold text-txt truncate">@du.DeptName</span>
                                    </span>
                                    <span class="inline-flex items-center justify-center min-w-[22px] px-1.5 py-0.5 rounded-full bg-pri/10 text-pri text-[10px] font-bold shrink-0">@du.Reports.Count</span>
                                </button>
                                <div x-show="open" x-cloak x-transition class="px-3 pb-3 pt-2.5 border-t border-bdr-light">
                                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-1.5">
                                        @foreach (var r in du.Reports)
                                        {
                                            var dotCls = r.ReportTool switch
                                            {
                                                "Internal" => "bg-emerald-500",
                                                "SmartQuery" => "bg-amber-500",
                                                "SSRS" => "bg-indigo-500",
                                                _ => "bg-txt-ter"
                                            };
                                            <li class="flex items-start gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full shrink-0 mt-1.5 @dotCls"></span>
                                                <span class="text-[11px] leading-snug text-txt-sec">@r.ReportName</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- 上海寶工 -->
            <div class="p-4">
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    <span class="text-[13px] font-bold text-txt">上海寶工</span>
                    <span class="text-[11px] text-txt-ter">@Model.Stats.DeptUsagesSH.Count 個部門</span>
                </div>
                @if (Model.Stats.DeptUsagesSH.Count == 0)
                {
                    <div class="text-center py-6 text-[12px] text-txt-ter">尚無部門報表指派</div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var du in Model.Stats.DeptUsagesSH)
                        {
                            <div class="rounded-lg bg-surface/60 border border-bdr-light overflow-hidden"
                                 x-data="{ open: false }" @@dept-toggle-all.window="open = $event.detail.open">
                                <button type="button" @@click="open = !open"
                                        class="w-full flex items-center justify-between gap-2 px-3 py-2.5 border-0 bg-transparent cursor-pointer text-left hover:bg-amber-500/5 transition-colors">
                                    <span class="flex items-center gap-2 min-w-0">
                                        <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-txt-ter shrink-0 transition-transform" :class="open && 'rotate-90'"></i>
                                        <span class="text-[12px] font-semibold text-txt truncate">@du.DeptName</span>
                                    </span>
                                    <span class="inline-flex items-center justify-center min-w-[22px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-700 text-[10px] font-bold shrink-0">@du.Reports.Count</span>
                                </button>
                                <div x-show="open" x-cloak x-transition class="px-3 pb-3 pt-2.5 border-t border-bdr-light">
                                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-1.5">
                                        @foreach (var r in du.Reports)
                                        {
                                            var dotCls = r.ReportTool switch
                                            {
                                                "Internal" => "bg-emerald-500",
                                                "SmartQuery" => "bg-amber-500",
                                                "SSRS" => "bg-indigo-500",
                                                _ => "bg-txt-ter"
                                            };
                                            <li class="flex items-start gap-2">
                                                <span class="w-1.5 h-1.5 rounded-full shrink-0 mt-1.5 @dotCls"></span>
                                                <span class="text-[11px] leading-snug text-txt-sec">@r.ReportName</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 孤立報表 -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm mb-5">
        <div class="px-5 py-3.5 border-b border-bdr flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-bad"></i>
            <h2 class="text-[14px] font-semibold text-txt">未指派部門的報表</h2>
            @if (Model.Stats.OrphanCount > 0)
            {
                <span class="ml-auto px-2 py-0.5 rounded-full bg-bad/10 text-bad text-[11px] font-semibold">@Model.Stats.OrphanCount</span>
            }
        </div>
        <div class="p-5">
            @if (Model.Stats.OrphanItems.Count == 0)
            {
                <div class="text-center py-8">
                    <i data-lucide="check-circle" class="w-8 h-8 text-ok mx-auto mb-2"></i>
                    <div class="text-[13px] text-txt-sec">所有報表皆已指派部門</div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                    @foreach (var orphan in Model.Stats.OrphanItems)
                    {
                        var toolCls = orphan.ReportTool switch
                        {
                            "Internal" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                            "SmartQuery" => "bg-amber-50 text-amber-700 border-amber-200",
                            "SSRS" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                            _ => "bg-surface text-txt-sec border-bdr"
                        };
                        <div class="flex items-center gap-3 p-3 rounded-lg border border-bdr hover:border-bad/30 transition-colors">
                            <div class="flex-1 min-w-0">
                                <div class="text-[13px] font-medium text-txt truncate">@orphan.ReportName</div>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border @toolCls">@orphan.ReportTool</span>
                                    @if (!orphan.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] text-bad">
                                            <span class="w-1.5 h-1.5 rounded-full bg-bad"></span>停用
                                        </span>
                                    }
                                </div>
                            </div>
                            <a href="/Admin/Catalog?edit=@orphan.ReportID" class="text-[11px] text-pri hover:underline no-underline whitespace-nowrap">指派部門</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 冷門報表 (90 日內 0 次使用) -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm">
        <div class="px-5 py-3.5 border-b border-bdr flex items-center gap-2">
            <i data-lucide="snowflake" class="w-4 h-4 text-sky-500"></i>
            <h2 class="text-[14px] font-semibold text-txt">冷門報表</h2>
            <span class="text-[11px] text-txt-ter">啟用中但近 90 日 0 次使用</span>
            @if (Model.ColdTotal > 0)
            {
                <span class="ml-auto px-2 py-0.5 rounded-full bg-bad/10 text-bad text-[11px] font-semibold">@Model.ColdTotal</span>
            }
        </div>
        <div class="p-5">
            @if (Model.ColdTotal == 0)
            {
                <div class="text-center py-8">
                    <i data-lucide="check-circle" class="w-8 h-8 text-ok mx-auto mb-2"></i>
                    <div class="text-[13px] text-txt-sec">所有啟用中的報表近 90 日皆有使用</div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                    @foreach (var cold in Model.ColdReports)
                    {
                        var coldToolCls = cold.ReportTool switch
                        {
                            "Internal" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                            "SmartQuery" => "bg-amber-50 text-amber-700 border-amber-200",
                            "SSRS" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                            _ => "bg-surface text-txt-sec border-bdr"
                        };
                        <div class="flex items-center gap-3 p-3 rounded-lg border border-bdr hover:border-sky-300 transition-colors">
                            <div class="flex-1 min-w-0">
                                <div class="text-[13px] font-medium text-txt truncate">@cold.ReportName</div>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border @coldToolCls">@cold.ReportTool</span>
                                    @if (cold.LastUsed.HasValue)
                                    {
                                        <span class="text-[10px] text-txt-ter">最後使用 @cold.LastUsed.Value.ToString("yyyy/MM/dd")</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-bad/10 text-bad text-[10px] font-medium">從未使用</span>
                                    }
                                </div>
                            </div>
                            <a href="/Admin/Usage?reportId=@cold.ReportID" class="text-[11px] text-pri hover:underline no-underline whitespace-nowrap">查看記錄</a>
                        </div>
                    }
                </div>
                <div class="mt-3 text-right">
                    <a href="/Admin/Usage" class="text-[11px] text-pri hover:underline no-underline">
                        @if (Model.ColdTotal > Model.ColdReports.Count)
                        {
                            <text>還有 @(Model.ColdTotal - Model.ColdReports.Count) 筆，查看完整清單 →</text>
                        }
                        else
                        {
                            <text>前往使用分析 →</text>
                        }
                    </a>
                </div>
            }
        </div>
    </div>

</div>
