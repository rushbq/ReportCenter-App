@page
@using System.Text.Json
@using System.Text.Encodings.Web
@model ReportCenter.Web.Pages.Admin.CatalogModel

@{
    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var itemsJson = JsonSerializer.Serialize(Model.CatalogItems.Select(i => new {
        reportID = i.ReportID,
        reportName = i.ReportName,
        reportTool = i.ReportTool,
        reportPath = i.ReportPath,
        reportCode = i.ReportCode,
        sourceName = i.SourceName,
        createDate = i.CreateDate.ToString("yyyy/MM/dd"),
        modifyDate = i.ModifyDate?.ToString("yyyy/MM/dd") ?? "",
        displayDate = (i.ModifyDate ?? i.CreateDate).ToString("yyyy/MM/dd"),
        isActive = i.IsActive,
        remarks = i.Remarks,
        useCompanyParam = i.UseCompanyParam,
        categoryID = i.CategoryID,
        categoryName = i.CategoryName,
        departments = i.Departments.Select(d => new { deptID = d.DeptID, deptName = d.DeptName }),
        dependencies = i.Dependencies
    }), jsonOpts);
    var deptsTwJson = JsonSerializer.Serialize(Model.AllDeptsTW.Select(d => new {
        area = d.Area,
        deptID = d.DeptID,
        deptName = d.DeptName,
        label = d.DeptID + "-" + d.DeptName
    }), jsonOpts);
    var deptsCnJson = JsonSerializer.Serialize(Model.AllDeptsCN.Select(d => new {
        area = d.Area,
        deptID = d.DeptID,
        deptName = d.DeptName,
        label = d.DeptID + "-" + d.DeptName
    }), jsonOpts);
    var catalogDeptsJson = JsonSerializer.Serialize(Model.CatalogDepts.Select(d => new {
        area = d.Area,
        deptID = d.DeptID,
        deptName = d.DeptName,
        label = d.DeptID + "-" + d.DeptName
    }), jsonOpts);
    var depObjectsJson = JsonSerializer.Serialize(Model.AllDependencies, jsonOpts);
    var categoriesJson = JsonSerializer.Serialize(Model.Categories.Select(c => new {
        categoryID = c.CategoryID,
        categoryName = c.CategoryName,
        isActive = c.IsActive
    }), jsonOpts);
    var reportFoldersJson = JsonSerializer.Serialize(Model.ReportFolders.Select(f => new {
        value = (int)f.Value,
        label = f.Label
    }), jsonOpts);
    var baseUrlsJson = JsonSerializer.Serialize(new {
        smartQuery = Model.BaseUrls.SmartQuery,
        ssrs = Model.BaseUrls.SSRS
    }, jsonOpts);
    // 取得不重複的報表資料夾清單供篩選使用
    var reportPaths = Model.CatalogItems.Select(i => i.ReportPath).Where(p => !string.IsNullOrWhiteSpace(p) && p != "-").Distinct().OrderBy(p => p).ToList();
    var reportPathsJson = JsonSerializer.Serialize(reportPaths, jsonOpts);
}

<div class="p-4 md:p-6 pb-10 max-w-[1200px]"
     x-data="catalogPage()" x-init="init()">

    <!-- 麵包屑 -->
    <div class="flex items-center gap-1.5 text-[12px] text-txt-ter mb-4">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <a href="/Admin" class="hover:text-pri no-underline text-txt-ter">系統管理</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <span class="text-txt font-medium">報表目錄管理</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div>
            <h1 class="text-[20px] md:text-[22px] font-bold text-txt">報表目錄管理</h1>
            <div class="text-[12px] text-txt-ter mt-1">新增、編輯、管理所有報表清冊</div>
        </div>
        <button @@click="openCreate()"
                class="inline-flex items-center gap-2 px-4 py-2 bg-pri text-white rounded-lg text-[13px] font-medium border-0 cursor-pointer hover:bg-pri-hover transition-colors">
            <i data-lucide="plus" class="w-4 h-4"></i>
            新增報表
        </button>
    </div>

    <!-- 篩選列 -->
    <div class="sticky top-14 z-40 bg-white rounded-xl border border-bdr shadow-sm px-4 py-3 mb-4 flex flex-wrap items-center gap-3">
        <!-- 搜尋 -->
        <div class="relative flex-1 min-w-[180px] max-w-[300px]">
            <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-txt-ter"></i>
            <input type="text" x-model.debounce.200ms="search" placeholder="搜尋報表名稱、來源..."
                   class="w-full pl-9 pr-3 py-1.5 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors bg-surface">
        </div>

        <!-- 工具類型 chips -->
        <div class="flex gap-1.5">
            <button @@click="toolFilter = ''"
                    :class="toolFilter === '' ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr hover:border-pri/40'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">全部</button>
            <button @@click="toolFilter = 'Internal'"
                    :class="toolFilter === 'Internal' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:border-emerald-400'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">Internal</button>
            <button @@click="toolFilter = 'SmartQuery'"
                    :class="toolFilter === 'SmartQuery' ? 'bg-amber-600 text-white border-amber-600' : 'bg-amber-50 text-amber-700 border-amber-200 hover:border-amber-400'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">SmartQuery</button>
            <button @@click="toolFilter = 'SSRS'"
                    :class="toolFilter === 'SSRS' ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-indigo-50 text-indigo-700 border-indigo-200 hover:border-indigo-400'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">SSRS</button>
        </div>

        <!-- 分隔線 -->
        <div class="w-px h-6 bg-bdr"></div>

        <!-- 狀態 chips -->
        <div class="flex gap-1.5">
            <button @@click="activeFilter = ''"
                    :class="activeFilter === '' ? 'bg-pri/10 text-pri border-pri/20' : 'bg-white text-txt-sec border-bdr hover:border-pri/40'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">全部</button>
            <button @@click="activeFilter = 'true'"
                    :class="activeFilter === 'true' ? 'bg-ok/10 text-ok border-ok/30' : 'bg-white text-txt-sec border-bdr hover:border-ok/40'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">啟用</button>
            <button @@click="activeFilter = 'false'"
                    :class="activeFilter === 'false' ? 'bg-bad/10 text-bad border-bad/30' : 'bg-white text-txt-sec border-bdr hover:border-bad/40'"
                    class="px-3 py-1 rounded-full text-[11px] font-medium border cursor-pointer transition-colors">停用</button>
        </div>

        <!-- 分隔線 -->
        <div class="w-px h-6 bg-bdr"></div>

        <!-- 報表資料夾篩選 -->
        <select x-model="pathFilter"
                class="px-3 py-1 rounded-lg border border-bdr text-[11px] outline-none focus:border-pri transition-colors bg-white text-txt-sec">
            <option value="">全部資料夾</option>
            <template x-for="p in allPaths" :key="p">
                <option :value="p" x-text="p"></option>
            </template>
        </select>

        <!-- 報表數 -->
        <div class="ml-auto text-[11px] text-txt-ter">
            共 <span class="font-semibold text-txt" x-text="filtered.length"></span> 份報表
        </div>
    </div>

    <!-- 資料表格 -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-[13px]">
                <thead>
                    <tr class="bg-surface text-txt-sec text-[11px]">
                        <th class="px-4 py-2.5 text-left font-semibold w-[40px]">#</th>
                        <th class="px-4 py-2.5 text-left font-semibold">報表名稱</th>
                        <th class="px-3 py-2.5 text-center font-semibold w-[100px]">工具類型</th>
                        <th class="px-3 py-2.5 text-left font-semibold hidden lg:table-cell">資料來源</th>
                        <th class="px-3 py-2.5 text-center font-semibold w-[60px]">狀態</th>
                        <th class="px-3 py-2.5 text-left font-semibold hidden md:table-cell">部門</th>
                        <th class="px-3 py-2.5 text-left font-semibold hidden lg:table-cell w-[90px]">分類</th>
                        <th class="px-3 py-2.5 text-center font-semibold w-[90px] hidden sm:table-cell">更新日期</th>
                        <th class="px-4 py-2.5 text-center font-semibold w-[100px]">操作</th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="item in filtered" :key="item.reportID">
                        <tr class="border-t border-bdr-light hover:bg-surface/50 transition-colors">
                            <td class="px-4 py-3 text-[11px] text-txt-ter" x-text="item.reportID"></td>
                            <td class="px-4 py-3">
                                <button @@click="openEdit(item)" class="font-medium text-txt hover:text-pri cursor-pointer border-0 bg-transparent p-0 text-left text-[13px] transition-colors" x-text="item.reportName"></button>
                                <div class="text-[11px] text-txt-ter mt-0.5 truncate max-w-[250px]" x-text="item.reportPath" x-show="item.reportPath"></div>
                            </td>
                            <td class="px-3 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border"
                                      :class="toolClasses(item.reportTool)" x-text="item.reportTool"></span>
                            </td>
                            <td class="px-3 py-3 hidden lg:table-cell">
                                <span class="text-[11px] font-mono text-txt-sec" x-text="item.sourceName || '-'"></span>
                            </td>
                            <td class="px-3 py-3 text-center">
                                <template x-if="item.isActive">
                                    <span class="inline-flex items-center gap-1 text-[11px] text-ok"><span class="w-1.5 h-1.5 rounded-full bg-ok"></span>啟用</span>
                                </template>
                                <template x-if="!item.isActive">
                                    <span class="inline-flex items-center gap-1 text-[11px] text-bad"><span class="w-1.5 h-1.5 rounded-full bg-bad"></span>停用</span>
                                </template>
                            </td>
                            <td class="px-3 py-3 hidden md:table-cell">
                                <div class="flex flex-wrap gap-1">
                                    <template x-for="(d, di) in item.departments.slice(0, 3)" :key="di">
                                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-surface text-txt-sec border border-bdr-light" x-text="d.deptName"></span>
                                    </template>
                                    <span x-show="item.departments.length > 3"
                                          class="text-[10px] px-1.5 py-0.5 rounded bg-pri/5 text-pri font-medium"
                                          x-text="'+' + (item.departments.length - 3)"></span>
                                    <span x-show="item.departments.length === 0" class="text-[10px] text-bad">未指派</span>
                                </div>
                            </td>
                            <td class="px-3 py-3 hidden lg:table-cell">
                                <span x-show="item.categoryName" class="text-[10px] px-1.5 py-0.5 rounded-full bg-pri-light text-pri font-medium" x-text="item.categoryName"></span>
                                <span x-show="!item.categoryName" class="text-[10px] text-txt-ter">-</span>
                            </td>
                            <td class="px-3 py-3 text-center text-[11px] text-txt-sec hidden sm:table-cell" x-text="item.displayDate"></td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <button @@click="openEdit(item)" title="編輯"
                                            class="p-1.5 rounded-lg hover:bg-pri-light text-txt-sec hover:text-pri cursor-pointer border-0 bg-transparent transition-colors">
                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                    </button>
                                    <button @@click="toggleActive(item)" :title="item.isActive ? '停用' : '啟用'"
                                            class="p-1.5 rounded-lg hover:bg-surface text-txt-sec cursor-pointer border-0 bg-transparent transition-colors"
                                            :class="item.isActive ? 'hover:text-bad' : 'hover:text-ok'">
                                        <i data-lucide="power" class="w-3.5 h-3.5"></i>
                                    </button>
                                    <button @@click="confirmDelete(item)" title="刪除"
                                            class="p-1.5 rounded-lg hover:bg-bad/10 text-txt-sec hover:text-bad cursor-pointer border-0 bg-transparent transition-colors">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <!-- 空白狀態 -->
        <div x-show="filtered.length === 0" class="py-16 text-center">
            <i data-lucide="file-x" class="w-10 h-10 text-txt-ter mx-auto mb-3"></i>
            <div class="text-[14px] text-txt-sec">尚無符合條件的報表</div>
            <div class="text-[12px] text-txt-ter mt-1">請調整篩選條件或新增報表</div>
        </div>
    </div>

    <!-- 編輯/新增 Modal -->
    <div x-show="modalOpen" x-cloak class="fixed inset-0 z-[100] flex items-start justify-center pt-[5vh]"
         x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">

        <!-- 背景遮罩 -->
        <div class="absolute inset-0 bg-black/40" @@click="modalOpen = false"></div>

        <!-- Modal 面板 -->
        <div class="relative w-full max-w-[640px] mx-4 bg-white rounded-xl shadow-2xl max-h-[85vh] flex flex-col"
             @@click.stop>
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-bdr shrink-0">
                <h3 class="text-[16px] font-bold text-txt" x-text="isEdit ? '編輯報表' : '新增報表'"></h3>
                <button @@click="modalOpen = false" class="p-1 rounded-lg hover:bg-surface border-0 bg-transparent cursor-pointer text-txt-sec hover:text-txt transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- 表單內容 -->
            <div class="overflow-y-auto flex-1 px-6 py-5 space-y-4">
                <!-- 報表名稱 -->
                <div>
                    <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">報表名稱 <span class="text-bad">*</span></label>
                    <input type="text" x-model="form.reportName"
                           class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors"
                           placeholder="輸入報表名稱">
                </div>

                <!-- 工具類型 + 報表資料夾 -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">工具類型</label>
                        <select x-model="form.reportTool"
                                class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors bg-white">
                            <option value="Internal">Internal (內部報表)</option>
                            <option value="SmartQuery">SmartQuery</option>
                            <option value="SSRS">SSRS</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">報表資料夾</label>
                        <select x-model="form.reportPath"
                                class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors bg-white">
                            <option value="">請選擇</option>
                            <template x-for="folder in reportFolders" :key="folder.value">
                                <option :value="folder.label" x-text="folder.label"></option>
                            </template>
                        </select>
                    </div>
                </div>

                <!-- 報表代碼/連結 -->
                <div>
                    <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">
                        <span x-text="form.reportTool === 'Internal' ? '內部路由' : (form.reportTool === 'SmartQuery' ? 'SmartQuery 路徑' : 'SSRS 路徑')"></span>
                    </label>
                    <!-- BASE URL 提示 (從 appsettings 讀取) -->
                    <div x-show="form.reportTool !== 'Internal'" class="flex items-center gap-0 mb-0">
                        <span class="inline-flex items-center px-3 py-2 rounded-l-lg border border-r-0 border-bdr bg-surface text-[11px] text-txt-ter font-mono whitespace-nowrap"
                              x-text="form.reportTool === 'SmartQuery' ? baseUrls.smartQuery : baseUrls.ssrs"></span>
                        <input type="text" x-model="form.reportCode"
                               class="flex-1 px-3 py-2 rounded-r-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors font-mono"
                               :placeholder="form.reportTool === 'SmartQuery' ? 'GUID 路徑' : '報表路徑'">
                    </div>
                    <div x-show="form.reportTool === 'Internal'">
                        <input type="text" x-model="form.reportCode"
                               class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors font-mono"
                               placeholder="/Report?dept=...">
                    </div>
                </div>

                <!-- 資料來源 -->
                <div>
                    <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">資料來源 (SP/函數)</label>
                    <input type="text" x-model="form.sourceName"
                           class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors font-mono"
                           placeholder="例: usp_Rpt_SalesRanking">
                </div>

                <!-- 啟用開關 -->
                <div class="flex items-center gap-3">
                    <label class="text-[12px] font-semibold text-txt-sec shrink-0">狀態</label>
                    <button @@click="form.isActive = !form.isActive" type="button"
                            :class="form.isActive ? 'bg-ok' : 'bg-gray-300'"
                            class="relative shrink-0 w-10 h-5 rounded-full border-0 cursor-pointer transition-colors">
                        <span :class="form.isActive ? 'translate-x-5' : 'translate-x-0.5'"
                              class="absolute top-0.5 left-0 w-4 h-4 bg-white rounded-full shadow transition-transform"></span>
                    </button>
                    <span class="text-[11px] shrink-0" :class="form.isActive ? 'text-ok' : 'text-bad'" x-text="form.isActive ? '啟用' : '停用'"></span>
                </div>

                <!-- 分類 -->
                <div>
                    <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">報表分類</label>
                    <select x-model="form.categoryID"
                            class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors bg-white">
                        <option :value="null">未分類</option>
                        <template x-for="cat in filteredCategories" :key="cat.categoryID">
                            <option :value="cat.categoryID" x-text="cat.categoryName" :selected="form.categoryID == cat.categoryID"></option>
                        </template>
                    </select>
                    <p class="text-[10px] text-txt-ter mt-1" x-show="allCategories.length === 0">尚未建立分類，請先至資料庫新增 ReportCategory 資料</p>
                </div>

                <!-- 公司別參數 -->
                <div class="flex items-center gap-3">
                    <label class="text-[12px] font-semibold text-txt-sec shrink-0">帶公司別參數</label>
                    <button @@click="form.useCompanyParam = !form.useCompanyParam" type="button"
                            :class="form.useCompanyParam ? 'bg-pri' : 'bg-gray-300'"
                            class="relative shrink-0 w-10 h-5 rounded-full border-0 cursor-pointer transition-colors">
                        <span :class="form.useCompanyParam ? 'translate-x-5' : 'translate-x-0.5'"
                              class="absolute top-0.5 left-0 w-4 h-4 bg-white rounded-full shadow transition-transform"></span>
                    </button>
                    <span class="text-[11px] text-txt-ter" x-show="form.useCompanyParam">URL 將自動帶入 dbs={companyId}</span>
                    <span class="text-[11px] text-txt-ter" x-show="!form.useCompanyParam">不帶公司別</span>
                </div>

                <!-- 分隔線 -->
                <div class="border-t border-bdr pt-4">
                    <label class="block text-[12px] font-semibold text-txt-sec mb-2.5">部門指派</label>
                    <div class="max-h-[280px] overflow-y-auto space-y-3">
                        <!-- 台灣 -->
                        <div>
                            <div class="text-[11px] font-bold text-txt-ter uppercase tracking-wider mb-1.5 pl-1 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-pri"></span>台灣寶工
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                <template x-for="dept in deptsTW" :key="dept.deptID">
                                    <label class="flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-colors text-[12px]"
                                           :class="selectedDepts.includes(dept.deptID) ? 'bg-pri-light border-pri/30 text-pri font-medium' : 'border-bdr text-txt-sec hover:border-pri/20'">
                                        <input type="checkbox" :value="dept.deptID"
                                               :checked="selectedDepts.includes(dept.deptID)"
                                               @@change="toggleDept(dept.deptID)"
                                               class="accent-pri w-3.5 h-3.5">
                                        <span x-text="dept.deptName"></span>
                                    </label>
                                </template>
                            </div>
                        </div>
                        <!-- 上海 -->
                        <div>
                            <div class="text-[11px] font-bold text-txt-ter uppercase tracking-wider mb-1.5 pl-1 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-amber-500"></span>上海寶工
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                <template x-for="dept in deptsCN" :key="dept.deptID">
                                    <label class="flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-colors text-[12px]"
                                           :class="selectedDepts.includes(dept.deptID) ? 'bg-amber-50 border-amber-300 text-amber-700 font-medium' : 'border-bdr text-txt-sec hover:border-amber-200'">
                                        <input type="checkbox" :value="dept.deptID"
                                               :checked="selectedDepts.includes(dept.deptID)"
                                               @@change="toggleDept(dept.deptID)"
                                               class="accent-amber-500 w-3.5 h-3.5">
                                        <span x-text="dept.deptName"></span>
                                    </label>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 相依物件 -->
                <div class="border-t border-bdr pt-4">
                    <label class="block text-[12px] font-semibold text-txt-sec mb-2.5">相依物件</label>
                    <!-- 已加入的 chips -->
                    <div class="flex flex-wrap gap-1.5 mb-2" x-show="deps.length > 0">
                        <template x-for="(dep, di) in deps" :key="di">
                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-surface border border-bdr text-[11px] font-mono text-txt-sec">
                                <span x-text="dep"></span>
                                <button @@click="deps.splice(di, 1)" class="p-0 border-0 bg-transparent cursor-pointer text-txt-ter hover:text-bad ml-0.5">
                                    <i data-lucide="x" class="w-3 h-3"></i>
                                </button>
                            </span>
                        </template>
                    </div>
                    <!-- 輸入 + Autocomplete -->
                    <div class="relative">
                        <input type="text" x-model="depInput"
                               @@keydown.enter.prevent="addDep()"
                               @@input="depSugOpen = depInput.length > 0"
                               @@focus="depSugOpen = depInput.length > 0"
                               @@click.outside="depSugOpen = false"
                               class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] font-mono outline-none focus:border-pri transition-colors"
                               placeholder="輸入物件名稱後按 Enter 加入">
                        <!-- 建議清單 -->
                        <div x-show="depSugOpen && depSuggestions.length > 0" x-cloak
                             class="absolute left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 max-h-[160px] overflow-y-auto z-50">
                            <template x-for="sug in depSuggestions.slice(0, 8)" :key="sug">
                                <button @@click="depInput = sug; addDep(); depSugOpen = false"
                                        class="w-full text-left px-3 py-1.5 text-[12px] font-mono text-txt-sec hover:bg-surface cursor-pointer border-0 bg-transparent"
                                        x-text="sug"></button>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- 報表描述 (最下方) -->
                <div class="border-t border-bdr pt-4">
                    <label class="block text-[12px] font-semibold text-txt-sec mb-1.5">報表描述</label>
                    <textarea x-model="form.remarks" rows="2"
                              class="w-full px-3 py-2 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors resize-none"
                              placeholder="選填"></textarea>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-bdr shrink-0">
                <button @@click="modalOpen = false"
                        class="px-4 py-2 rounded-lg border border-bdr text-[13px] text-txt-sec hover:bg-surface cursor-pointer bg-white transition-colors">
                    取消
                </button>
                <button @@click="save()"
                        class="px-5 py-2 rounded-lg bg-pri text-white text-[13px] font-medium border-0 cursor-pointer hover:bg-pri-hover transition-colors">
                    <span x-text="isEdit ? '儲存變更' : '新增報表'"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- 刪除確認 Modal -->
    <div x-show="deleteOpen" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center"
         x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100">
        <div class="absolute inset-0 bg-black/40" @@click="deleteOpen = false"></div>
        <div class="relative bg-white rounded-xl shadow-2xl p-6 max-w-[380px] mx-4" @@click.stop>
            <div class="text-center">
                <div class="w-12 h-12 rounded-full bg-bad/10 flex items-center justify-center mx-auto mb-3">
                    <i data-lucide="trash-2" class="w-6 h-6 text-bad"></i>
                </div>
                <h3 class="text-[15px] font-bold text-txt mb-1">確認刪除</h3>
                <p class="text-[13px] text-txt-sec">確定要刪除「<span class="font-medium text-txt" x-text="deleteItem?.reportName"></span>」嗎？此操作無法復原。</p>
            </div>
            <div class="flex gap-2 mt-5">
                <button @@click="deleteOpen = false"
                        class="flex-1 px-4 py-2 rounded-lg border border-bdr text-[13px] text-txt-sec hover:bg-surface cursor-pointer bg-white transition-colors">取消</button>
                <button @@click="doDelete()"
                        class="flex-1 px-4 py-2 rounded-lg bg-bad text-white text-[13px] font-medium border-0 cursor-pointer hover:bg-red-600 transition-colors">刪除</button>
            </div>
        </div>
    </div>

    <!-- Hidden Forms for POST -->
    <form x-ref="saveForm" method="post" asp-page-handler="Save" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" x-bind:value="form.reportID">
        <input type="hidden" name="reportName" x-bind:value="form.reportName">
        <input type="hidden" name="reportTool" x-bind:value="form.reportTool">
        <input type="hidden" name="reportPath" x-bind:value="form.reportPath">
        <input type="hidden" name="reportCode" x-bind:value="form.reportCode">
        <input type="hidden" name="sourceName" x-bind:value="form.sourceName">
        <input type="hidden" name="isActive" x-bind:value="form.isActive">
        <input type="hidden" name="remarks" x-bind:value="form.remarks">
        <input type="hidden" name="useCompanyParam" x-bind:value="form.useCompanyParam">
        <input type="hidden" name="categoryId" x-bind:value="form.categoryID || ''">
        <input type="hidden" name="deptIds" x-bind:value="deptIdsString()">
        <input type="hidden" name="dependencies" x-bind:value="deps.join(',')">
    </form>
    <form x-ref="deleteForm" method="post" asp-page-handler="Delete" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" x-ref="deleteId">
    </form>
    <form x-ref="toggleForm" method="post" asp-page-handler="Toggle" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" x-ref="toggleId">
    </form>
</div>

@section Scripts {
<script>
function catalogPage() {
    return {
        // 篩選
        search: '',
        toolFilter: '',
        activeFilter: '',
        pathFilter: '',

        // 資料
        items: [],
        catalogDepts: [],
        deptsTW: [],
        deptsCN: [],
        allDepObjects: [],
        allCategories: [],
        allPaths: [],
        reportFolders: [],
        baseUrls: { smartQuery: '', ssrs: '' },

        // Modal
        modalOpen: false,
        isEdit: false,
        form: {},
        selectedDepts: [],
        deps: [],
        depInput: '',
        depSugOpen: false,

        // 刪除
        deleteOpen: false,
        deleteItem: null,

        get filtered() {
            return this.items.filter(i => {
                if (this.toolFilter && i.reportTool !== this.toolFilter) return false;
                if (this.activeFilter === 'true' && !i.isActive) return false;
                if (this.activeFilter === 'false' && i.isActive) return false;
                if (this.pathFilter && i.reportPath !== this.pathFilter) return false;
                if (this.search) {
                    const q = this.search.toLowerCase();
                    return i.reportName.toLowerCase().includes(q) ||
                           (i.sourceName || '').toLowerCase().includes(q) ||
                           (i.reportPath || '').toLowerCase().includes(q);
                }
                return true;
            });
        },

        get filteredCategories() {
            return this.allCategories.filter(c => c.isActive);
        },

        get depSuggestions() {
            if (!this.depInput) return [];
            const q = this.depInput.toLowerCase();
            return this.allDepObjects.filter(d =>
                d.toLowerCase().includes(q) && !this.deps.includes(d)
            );
        },

        init() {
            this.items = @Html.Raw(itemsJson);
            this.catalogDepts = @Html.Raw(catalogDeptsJson);
            this.deptsTW = @Html.Raw(deptsTwJson);
            this.deptsCN = @Html.Raw(deptsCnJson);
            this.allDepObjects = @Html.Raw(depObjectsJson);
            this.allCategories = @Html.Raw(categoriesJson);
            this.allPaths = @Html.Raw(reportPathsJson);
            this.reportFolders = @Html.Raw(reportFoldersJson);
            this.baseUrls = @Html.Raw(baseUrlsJson);

            // 檢查 URL 訊息
            const params = new URLSearchParams(window.location.search);
            const msg = params.get('msg');
            if (msg === 'saved') Alpine.store('toast').show('報表已儲存');
            if (msg === 'deleted') Alpine.store('toast').show('報表已刪除');
            if (msg === 'toggled') Alpine.store('toast').show('狀態已更新');

            // 檢查是否有 edit 參數
            const editId = params.get('edit');
            if (editId) {
                const item = this.items.find(i => i.reportID === parseInt(editId));
                if (item) this.$nextTick(() => this.openEdit(item));
            }

            // 清除 URL 參數
            if (msg || editId) {
                window.history.replaceState({}, '', window.location.pathname);
            }
        },

        resetForm() {
            this.form = {
                reportID: 0, reportName: '', reportTool: 'Internal',
                reportPath: '', reportCode: '', sourceName: '',
                isActive: true, remarks: '', useCompanyParam: false, categoryID: null
            };
            this.selectedDepts = [];
            this.deps = [];
            this.depInput = '';
        },

        openCreate() {
            this.resetForm();
            this.isEdit = false;
            this.modalOpen = true;
        },

        openEdit(item) {
            this.form = {
                reportID: item.reportID,
                reportName: item.reportName,
                reportTool: item.reportTool,
                reportPath: item.reportPath,
                reportCode: item.reportCode,
                sourceName: item.sourceName,
                isActive: item.isActive,
                remarks: item.remarks || '',
                useCompanyParam: item.useCompanyParam || false,
                categoryID: item.categoryID || null
            };
            this.selectedDepts = item.departments.map(d => String(d.deptID)).filter(Boolean);
            this.deps = [...(item.dependencies || [])];
            this.depInput = '';
            this.isEdit = true;
            this.modalOpen = true;
        },

        toggleDept(deptId) {
            const idx = this.selectedDepts.indexOf(deptId);
            if (idx >= 0) this.selectedDepts.splice(idx, 1);
            else this.selectedDepts.push(deptId);
        },

        addDep() {
            const val = this.depInput.trim();
            if (val && !this.deps.includes(val)) {
                this.deps.push(val);
            }
            this.depInput = '';
            this.depSugOpen = false;
        },

        deptIdsString() {
            // 格式: deptID|deptName,deptID|deptName,...
            return this.selectedDepts.map(id => {
                const dept = this.catalogDepts.find(d => d.deptID === id);
                return dept ? dept.deptID + '|' + dept.deptName : '';
            }).filter(Boolean).join(',');
        },

        save() {
            if (!this.form.reportName.trim()) {
                Alpine.store('toast').show('請輸入報表名稱');
                return;
            }
            this.$refs.saveForm.submit();
        },

        toggleActive(item) {
            this.$refs.toggleId.value = item.reportID;
            this.$refs.toggleForm.submit();
        },

        confirmDelete(item) {
            this.deleteItem = item;
            this.deleteOpen = true;
        },

        doDelete() {
            this.$refs.deleteId.value = this.deleteItem.reportID;
            this.$refs.deleteForm.submit();
        },

        toolClasses(tool) {
            const map = {
                'Internal': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                'SmartQuery': 'bg-amber-50 text-amber-700 border-amber-200',
                'SSRS': 'bg-indigo-50 text-indigo-700 border-indigo-200',
            };
            return map[tool] || 'bg-surface text-txt-sec border-bdr';
        }
    };
}
</script>
}
