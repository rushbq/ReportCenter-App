@page
@using System.Text.Json
@using System.Text.Encodings.Web
@model ReportCenter.Web.Pages.Admin.CatalogModel

@if (Model.AccessDenied)
{
    <partial name="_AccessDenied" />
    return;
}

@{
    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var itemsJson = JsonSerializer.Serialize(Model.CatalogItems.Select(i => new {
        reportID = i.ReportID,
        reportName = i.ReportName,
        reportTool = i.ReportTool,
        reportPath = i.ReportPath,
        reportCode = i.ReportCode,
        sourceName = i.SourceName,
        createDate = i.CreateDate.ToString("yyyy/MM/dd"),
        modifyDate = i.ModifyDate?.ToString("yyyy/MM/dd") ?? "",
        displayDate = (i.ModifyDate ?? i.CreateDate).ToString("yyyy/MM/dd"),
        isActive = i.IsActive,
        remarks = i.Remarks,
        useCompanyParam = i.UseCompanyParam,
        categoryID = i.CategoryID,
        categoryName = i.CategoryName,
        departments = i.Departments.Select(d => new { deptID = d.DeptID, deptName = d.DeptName }),
        dependencies = i.Dependencies,
        // 近 30 日使用彙總；查無 key 表示期間內 0 次
        usageClicks = Model.UsageMap.TryGetValue(i.ReportID, out var u) ? u.Clicks : 0,
        usageLastUsed = Model.UsageMap.TryGetValue(i.ReportID, out var u2) ? u2.LastUsed?.ToString("yyyy/MM/dd") ?? "" : ""
    }), jsonOpts);
    var deptsTwJson = JsonSerializer.Serialize(Model.AllDeptsTW.Select(d => new {
        area = d.Area,
        deptID = d.DeptID,
        deptName = d.DeptName,
        label = d.DeptID + "-" + d.DeptName
    }), jsonOpts);
    var deptsCnJson = JsonSerializer.Serialize(Model.AllDeptsCN.Select(d => new {
        area = d.Area,
        deptID = d.DeptID,
        deptName = d.DeptName,
        label = d.DeptID + "-" + d.DeptName
    }), jsonOpts);
    var catalogDeptsJson = JsonSerializer.Serialize(Model.CatalogDepts.Select(d => new {
        area = d.Area,
        deptID = d.DeptID,
        deptName = d.DeptName,
        label = d.DeptID + "-" + d.DeptName
    }), jsonOpts);
    var depObjectsJson = JsonSerializer.Serialize(Model.AllDependencies, jsonOpts);
    var categoriesJson = JsonSerializer.Serialize(Model.Categories.Select(c => new {
        categoryID = c.CategoryID,
        categoryName = c.CategoryName,
        isActive = c.IsActive
    }), jsonOpts);
    var reportFoldersJson = JsonSerializer.Serialize(Model.ReportFolders.Select(f => new {
        value = (int)f.Value,
        label = f.Label
    }), jsonOpts);
    var baseUrlsJson = JsonSerializer.Serialize(new {
        smartQuery = Model.BaseUrls.SmartQuery,
        ssrs = Model.BaseUrls.SSRS
    }, jsonOpts);
    // 取得不重複的報表資料夾清單供篩選使用
    var reportPaths = Model.CatalogItems.Select(i => i.ReportPath).Where(p => !string.IsNullOrWhiteSpace(p) && p != "-").Distinct().OrderBy(p => p).ToList();
    var reportPathsJson = JsonSerializer.Serialize(reportPaths, jsonOpts);
}

<div class="page-container"
     x-data="catalogPage()" x-init="init()" @@keydown.window="onKey($event)">

    <!-- 麵包屑 -->
    <div class="flex items-center gap-1.5 text-[12px] text-txt-ter mb-4">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <a href="/Admin" class="hover:text-pri no-underline text-txt-ter">系統管理</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <span class="text-txt font-medium">報表目錄管理</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div>
            <h1 class="text-[20px] md:text-[22px] font-bold text-txt">報表目錄管理</h1>
            <div class="text-[12px] text-txt-ter mt-1">新增、編輯、管理所有報表清冊</div>
        </div>
        <button @@click="openCreate()"
                class="inline-flex items-center gap-2 px-4 py-2 bg-pri text-white rounded-lg text-[13px] font-medium border-0 cursor-pointer hover:bg-pri-hover transition-colors">
            <i data-lucide="plus" class="w-4 h-4"></i>
            新增報表
        </button>
    </div>

    <!-- 篩選列 (小螢幕不黏頂，避免佔掉三分之一畫面) -->
    <div class="md:sticky md:top-14 z-30 bg-white rounded-xl border border-bdr shadow-sm px-4 py-3 mb-4 flex flex-wrap items-center gap-x-3 gap-y-2.5">
        <!-- 搜尋 -->
        <div class="relative w-full sm:w-auto sm:flex-1 sm:min-w-[180px] sm:max-w-[300px]">
            <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-txt-ter"></i>
            <input type="search" x-model.debounce.200ms="search" placeholder="搜尋報表名稱、來源、資料夾" aria-label="搜尋報表"
                   class="w-full pl-9 pr-3 py-2 sm:py-1.5 rounded-lg border border-bdr text-[13px] outline-none focus:border-pri transition-colors bg-surface">
        </div>

        <!-- 工具類型 -->
        <div class="flex gap-1.5" role="group" aria-label="工具類型">
            <button type="button" @@click="toolFilter = ''" :aria-pressed="toolFilter === ''"
                    :class="toolFilter === '' ? 'bg-pri-light text-pri border-pri/30' : 'bg-white text-txt-sec border-bdr hover:border-pri/40'"
                    class="px-3 py-1.5 md:py-1 rounded-full text-[12px] md:text-[11px] font-medium border cursor-pointer transition-colors">全部類型</button>
            <button type="button" @@click="toolFilter = 'SmartQuery'" :aria-pressed="toolFilter === 'SmartQuery'"
                    :class="toolFilter === 'SmartQuery' ? 'bg-amber-600 text-white border-amber-600' : 'bg-amber-50 text-amber-700 border-amber-200 hover:border-amber-400'"
                    class="px-3 py-1.5 md:py-1 rounded-full text-[12px] md:text-[11px] font-medium border cursor-pointer transition-colors">SmartQuery</button>
            <button type="button" @@click="toolFilter = 'SSRS'" :aria-pressed="toolFilter === 'SSRS'"
                    :class="toolFilter === 'SSRS' ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-indigo-50 text-indigo-700 border-indigo-200 hover:border-indigo-400'"
                    class="px-3 py-1.5 md:py-1 rounded-full text-[12px] md:text-[11px] font-medium border cursor-pointer transition-colors">SSRS</button>
        </div>

        <div class="hidden sm:block w-px h-6 bg-bdr"></div>

        <!-- 狀態 -->
        <div class="flex gap-1.5" role="group" aria-label="啟用狀態">
            <button type="button" @@click="activeFilter = ''" :aria-pressed="activeFilter === ''"
                    :class="activeFilter === '' ? 'bg-pri-light text-pri border-pri/30' : 'bg-white text-txt-sec border-bdr hover:border-pri/40'"
                    class="px-3 py-1.5 md:py-1 rounded-full text-[12px] md:text-[11px] font-medium border cursor-pointer transition-colors">全部狀態</button>
            <button type="button" @@click="activeFilter = 'true'" :aria-pressed="activeFilter === 'true'"
                    :class="activeFilter === 'true' ? 'bg-ok/10 text-ok border-ok/30' : 'bg-white text-txt-sec border-bdr hover:border-ok/40'"
                    class="px-3 py-1.5 md:py-1 rounded-full text-[12px] md:text-[11px] font-medium border cursor-pointer transition-colors">啟用</button>
            <button type="button" @@click="activeFilter = 'false'" :aria-pressed="activeFilter === 'false'"
                    :class="activeFilter === 'false' ? 'bg-bad/10 text-bad border-bad/30' : 'bg-white text-txt-sec border-bdr hover:border-bad/40'"
                    class="px-3 py-1.5 md:py-1 rounded-full text-[12px] md:text-[11px] font-medium border cursor-pointer transition-colors">停用</button>
        </div>

        <div class="hidden sm:block w-px h-6 bg-bdr"></div>

        <!-- 報表資料夾 -->
        <select x-model="pathFilter" aria-label="報表資料夾"
                class="px-3 py-1.5 md:py-1 rounded-lg border border-bdr text-[12px] md:text-[11px] outline-none focus:border-pri transition-colors bg-white text-txt-sec">
            <option value="">全部資料夾</option>
            <template x-for="p in allPaths" :key="p">
                <option :value="p" x-text="p"></option>
            </template>
        </select>

        <!-- 筆數 + 清除 -->
        <div class="ml-auto flex items-center gap-3 text-[11px] text-txt-ter">
            <button type="button" x-show="hasFilter" x-cloak @@click="clearFilters()"
                    class="text-pri hover:underline bg-transparent border-0 cursor-pointer p-0 text-[11px]">清除篩選</button>
            <span>共 <span class="font-semibold text-txt tabular-nums" x-text="filtered.length"></span> 份報表</span>
        </div>
    </div>

    <!-- 清單：md 以上表格、以下卡片。列內圖示一律 inline SVG — x-for 重建的節點不會再跑 lucide.createIcons() -->
    <div class="bg-white rounded-xl border border-bdr shadow-sm overflow-hidden">

        <!-- 表格 (md+) -->
        <table class="hidden md:table w-full text-[13px]">
            <thead>
                <tr class="bg-surface text-txt-sec text-[11px] border-b border-bdr">
                    <th class="px-4 py-3 text-left font-semibold">報表</th>
                    <th class="px-3 py-3 text-left font-semibold w-[28%]">部門選單</th>
                    <th class="px-3 py-3 text-left font-semibold hidden xl:table-cell w-[96px]">分類</th>
                    <th class="px-3 py-3 text-right font-semibold hidden lg:table-cell w-[96px]" title="近 30 日點擊次數；滑過數字可看最後使用日">近 30 日</th>
                    <th class="px-3 py-3 text-left font-semibold w-[96px]">狀態</th>
                    <th class="px-3 py-3 w-[52px]"><span class="sr-only">編輯</span></th>
                </tr>
            </thead>
            <tbody>
                <template x-for="(item, idx) in filtered" :key="item.reportID">
                    <tr class="border-b border-bdr-light last:border-0 [&>td]:align-middle transition-colors duration-700 hover:bg-pri/5"
                        :id="'row-' + item.reportID"
                        :class="item.reportID === highlightId ? 'bg-amber-100' : 'bg-white'">
                        <td class="px-4 py-3">
                            <button type="button" @@click="openEdit(item)"
                                    class="font-semibold hover:text-pri cursor-pointer border-0 bg-transparent p-0 text-left text-[13px] transition-colors"
                                    :class="item.isActive ? 'text-txt' : 'text-txt-ter'" x-text="item.reportName"></button>
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1 text-[11px] text-txt-ter">
                                <span class="inline-flex items-center px-1.5 rounded text-[10px] font-medium border leading-[16px]"
                                      :class="toolClasses(item.reportTool)" x-text="item.reportTool"></span>
                                <span x-show="item.reportPath" class="inline-flex items-center gap-1 min-w-0">
                                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                                    <span class="truncate" x-text="item.reportPath"></span>
                                </span>
                                <span x-show="item.sourceName" class="inline-flex items-center gap-1 min-w-0">
                                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
                                    <span class="font-mono truncate max-w-[220px]" x-text="item.sourceName"></span>
                                </span>
                            </div>
                        </td>
                        <td class="px-3 py-3 text-[12px] text-txt-sec">
                            <template x-if="item.departments.length > 0">
                                <span>
                                    <span x-text="deptPreview(item)"></span><button type="button" x-show="item.departments.length > 2"
                                            @@click.stop="showDepts(item)"
                                            class="ml-1 text-pri hover:underline bg-transparent border-0 cursor-pointer p-0 text-[12px] whitespace-nowrap"
                                            x-text="'等 ' + item.departments.length + ' 個'"></button>
                                </span>
                            </template>
                            <span x-show="item.departments.length === 0" class="inline-flex items-center gap-1 text-bad whitespace-nowrap">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                                未指派
                            </span>
                        </td>
                        <td class="px-3 py-3 hidden xl:table-cell">
                            <span x-show="item.categoryName" class="text-[10px] px-1.5 py-0.5 rounded-full font-medium whitespace-nowrap" :class="catBadge(item.categoryName)" x-text="item.categoryName"></span>
                            <span x-show="!item.categoryName" class="text-[11px] text-txt-ter">未分類</span>
                        </td>
                        <td class="px-3 py-3 text-right hidden lg:table-cell">
                            <a x-show="item.usageClicks > 0" :href="'/Admin/Usage?reportId=' + item.reportID"
                               :title="'最後使用 ' + item.usageLastUsed + '，點擊查看明細'"
                               class="text-[12px] font-semibold text-pri tabular-nums no-underline hover:underline"
                               x-text="item.usageClicks + ' 次'"></a>
                            <span x-show="item.usageClicks === 0" class="text-[11px]"
                                  :class="item.isActive ? 'text-bad' : 'text-txt-ter'">未使用</span>
                        </td>
                        <td class="px-3 py-3">
                            <button type="button" role="switch" :aria-checked="item.isActive"
                                    :aria-label="(item.isActive ? '停用' : '啟用') + '「' + item.reportName + '」'"
                                    @@click.stop="confirmToggle(item)"
                                    class="inline-flex items-center gap-2 -mx-1.5 px-1.5 py-1.5 rounded-lg border-0 bg-transparent cursor-pointer hover:bg-surface transition-colors">
                                <span class="relative shrink-0 w-8 h-[18px] rounded-full transition-colors" :class="item.isActive ? 'bg-ok' : 'bg-gray-300'">
                                    <span class="absolute top-[2px] left-[2px] w-[14px] h-[14px] bg-white rounded-full shadow-sm transition-transform"
                                          :class="item.isActive ? 'translate-x-[14px]' : ''"></span>
                                </span>
                                <span class="text-[12px] font-medium" :class="item.isActive ? 'text-ok' : 'text-txt-ter'" x-text="item.isActive ? '啟用' : '停用'"></span>
                            </button>
                        </td>
                        <td class="px-3 py-3 text-right">
                            <button type="button" @@click="openEdit(item)" title="編輯" :aria-label="'編輯「' + item.reportName + '」'"
                                    class="inline-flex items-center justify-center w-9 h-9 rounded-lg hover:bg-pri-light text-txt-sec hover:text-pri cursor-pointer border-0 bg-transparent transition-colors">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                            </button>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>

        <!-- 卡片 (< md) -->
        <ul class="md:hidden divide-y divide-bdr-light">
            <template x-for="item in filtered" :key="item.reportID">
                <li class="px-4 py-3.5 transition-colors duration-700"
                    :id="'card-' + item.reportID"
                    :class="item.reportID === highlightId ? 'bg-amber-100' : 'bg-white'">
                    <div class="flex items-start gap-2">
                        <button type="button" @@click="openEdit(item)"
                                class="flex-1 min-w-0 text-left border-0 bg-transparent p-0 cursor-pointer">
                            <span class="block font-semibold text-[14px] leading-snug" :class="item.isActive ? 'text-txt' : 'text-txt-ter'" x-text="item.reportName"></span>
                            <span class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1 text-[11px] text-txt-ter">
                                <span class="inline-flex items-center px-1.5 rounded text-[10px] font-medium border leading-[16px]"
                                      :class="toolClasses(item.reportTool)" x-text="item.reportTool"></span>
                                <span x-show="item.reportPath" x-text="item.reportPath"></span>
                                <span x-show="item.sourceName" class="font-mono break-all" x-text="item.sourceName"></span>
                            </span>
                        </button>
                        <button type="button" @@click="openEdit(item)" :aria-label="'編輯「' + item.reportName + '」'"
                                class="shrink-0 -mr-2 -mt-1.5 inline-flex items-center justify-center w-11 h-11 rounded-lg text-txt-sec active:bg-pri-light cursor-pointer border-0 bg-transparent">
                            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                        </button>
                    </div>

                    <div class="mt-2 text-[12px] text-txt-sec">
                        <template x-if="item.departments.length > 0">
                            <span>
                                <span x-text="deptPreview(item)"></span><button type="button" x-show="item.departments.length > 2"
                                        @@click="showDepts(item)"
                                        class="ml-1 text-pri bg-transparent border-0 cursor-pointer p-0 text-[12px]"
                                        x-text="'等 ' + item.departments.length + ' 個'"></button>
                            </span>
                        </template>
                        <span x-show="item.departments.length === 0" class="inline-flex items-center gap-1 text-bad">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                            未指派部門選單
                        </span>
                    </div>

                    <div class="mt-1.5 flex items-center justify-between gap-3">
                        <button type="button" role="switch" :aria-checked="item.isActive"
                                :aria-label="(item.isActive ? '停用' : '啟用') + '「' + item.reportName + '」'"
                                @@click="confirmToggle(item)"
                                class="inline-flex items-center gap-2.5 -ml-1 px-1 min-h-[44px] rounded-lg border-0 bg-transparent cursor-pointer">
                            <span class="relative shrink-0 w-10 h-[22px] rounded-full transition-colors" :class="item.isActive ? 'bg-ok' : 'bg-gray-300'">
                                <span class="absolute top-[2px] left-[2px] w-[18px] h-[18px] bg-white rounded-full shadow-sm transition-transform"
                                      :class="item.isActive ? 'translate-x-[18px]' : ''"></span>
                            </span>
                            <span class="text-[13px] font-medium" :class="item.isActive ? 'text-ok' : 'text-txt-ter'" x-text="item.isActive ? '啟用' : '停用'"></span>
                        </button>
                        <a x-show="item.usageClicks > 0" :href="'/Admin/Usage?reportId=' + item.reportID"
                           class="inline-flex items-center min-h-[44px] text-[12px] text-pri tabular-nums no-underline"
                           x-text="'近 30 日 ' + item.usageClicks + ' 次'"></a>
                        <span x-show="item.usageClicks === 0" class="text-[12px]"
                              :class="item.isActive ? 'text-bad' : 'text-txt-ter'">近 30 日未使用</span>
                    </div>
                </li>
            </template>
        </ul>

        <!-- 空白狀態 -->
        <div x-show="filtered.length === 0" class="py-16 px-4 text-center">
            <i data-lucide="file-x" class="w-10 h-10 text-txt-ter mx-auto mb-3"></i>
            <div class="text-[14px] text-txt-sec">沒有符合條件的報表</div>
            <button type="button" x-show="hasFilter" @@click="clearFilters()"
                    class="mt-3 px-4 py-2 rounded-lg border border-bdr bg-white text-[13px] text-pri cursor-pointer hover:border-pri/40 transition-colors">清除篩選</button>
        </div>
    </div>

    <!-- 編輯/新增 Modal -->
    <partial name="_CatalogEditModal" />

    <!-- 刪除確認 Modal -->
    <partial name="_CatalogDeleteModal" />

    <!-- 停用/啟用確認 Modal -->
    <div x-show="toggleOpen" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center"
         x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100">
        <div class="absolute inset-0 bg-black/40" @@click="toggleOpen = false"></div>
        <div class="relative bg-white rounded-xl shadow-2xl p-6 max-w-[400px] mx-4" @@click.stop>
            <div class="text-center">
                <div class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3"
                     :class="toggleItem?.isActive ? 'bg-bad/10' : 'bg-ok/10'">
                    <svg class="w-6 h-6" :class="toggleItem?.isActive ? 'text-bad' : 'text-ok'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v10"/><path d="M18.4 6.6a9 9 0 1 1-12.77.04"/></svg>
                </div>
                <h3 class="text-[15px] font-bold text-txt mb-1" x-text="toggleItem?.isActive ? '確認停用報表' : '確認啟用報表'"></h3>
                <p class="text-[13px] text-txt-sec">
                    確定要<span x-text="toggleItem?.isActive ? '停用' : '啟用'"></span>「<span class="font-medium text-txt" x-text="toggleItem?.reportName"></span>」嗎？
                    <span x-show="toggleItem?.isActive" class="block mt-1 text-txt-ter text-[12px]">停用後使用者將無法在前台看到此報表。</span>
                    <span x-show="toggleItem?.isActive" class="block mt-1 text-[12px] tabular-nums"
                          :class="toggleItem?.usageClicks > 0 ? 'text-amber-700' : 'text-txt-ter'"
                          x-text="toggleItem?.usageClicks > 0
                              ? '近 30 日仍有 ' + toggleItem.usageClicks + ' 次使用，最後使用 ' + toggleItem.usageLastUsed
                              : '近 30 日無人使用'"></span>
                    <span x-show="!toggleItem?.isActive" class="block mt-1 text-txt-ter text-[12px]">啟用後此報表將顯示於前台。</span>
                </p>
            </div>
            <div class="flex gap-2 mt-5">
                <button @@click="toggleOpen = false"
                        class="flex-1 px-4 py-2 rounded-lg border border-bdr text-[13px] text-txt-sec hover:bg-surface cursor-pointer bg-white transition-colors">取消</button>
                <button @@click="doToggle()" :disabled="toggling"
                        class="flex-1 px-4 py-2 rounded-lg text-white text-[13px] font-medium border-0 cursor-pointer transition-colors disabled:opacity-60 disabled:cursor-wait"
                        :class="toggleItem?.isActive ? 'bg-bad hover:bg-red-600' : 'bg-ok hover:bg-emerald-600'">
                    <span x-text="toggling ? '處理中…' : (toggleItem?.isActive ? '停用' : '啟用')"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- 部門明細 Modal -->
    <div x-show="deptModalOpen" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center"
         x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100">
        <div class="absolute inset-0 bg-black/40" @@click="deptModalOpen = false"></div>
        <div class="relative bg-white rounded-xl shadow-2xl max-w-[440px] w-full mx-4 max-h-[70vh] flex flex-col" @@click.stop>
            <div class="flex items-start justify-between gap-3 px-5 py-3.5 border-b border-bdr shrink-0">
                <div class="min-w-0">
                    <div class="text-[10px] text-txt-ter mb-0.5">指派部門
                        <span class="text-pri font-semibold" x-text="'(' + (deptModalItem?.departments?.length || 0) + ')'"></span>
                    </div>
                    <h3 class="text-[14px] font-bold text-txt truncate" x-text="deptModalItem?.reportName"></h3>
                </div>
                <button @@click="deptModalOpen = false" class="p-1 rounded-lg hover:bg-surface border-0 bg-transparent cursor-pointer text-txt-sec hover:text-txt transition-colors shrink-0">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="overflow-y-auto flex-1 p-4">
                <div class="flex flex-wrap gap-1.5">
                    <template x-for="d in (deptModalItem?.departments || [])" :key="d.deptID">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface border border-bdr text-[12px] text-txt-sec">
                            <span class="text-[10px] text-txt-ter font-mono tabular-nums" x-text="d.deptID"></span>
                            <span class="text-txt" x-text="d.deptName"></span>
                        </span>
                    </template>
                </div>
                <div x-show="!deptModalItem?.departments?.length" class="text-center text-[12px] text-txt-ter py-6">尚未指派任何部門</div>
            </div>
        </div>
    </div>

    <!-- Hidden Forms for POST -->
    <form x-ref="saveForm" method="post" asp-page-handler="Save" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" x-bind:value="form.reportID">
        <input type="hidden" name="reportName" x-bind:value="form.reportName">
        <input type="hidden" name="reportTool" x-bind:value="form.reportTool">
        <input type="hidden" name="reportPath" x-bind:value="form.reportPath">
        <input type="hidden" name="reportCode" x-bind:value="form.reportCode">
        <input type="hidden" name="sourceName" x-bind:value="form.sourceName">
        <input type="hidden" name="isActive" x-bind:value="form.isActive">
        <input type="hidden" name="remarks" x-bind:value="form.remarks">
        <input type="hidden" name="useCompanyParam" x-bind:value="form.useCompanyParam">
        <input type="hidden" name="categoryId" x-bind:value="form.categoryID || ''">
        <input type="hidden" name="deptIds" x-bind:value="deptIdsString()">
        <input type="hidden" name="dependencies" x-bind:value="deps.join(',')">
    </form>
    <form x-ref="deleteForm" method="post" asp-page-handler="Delete" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reportId" x-ref="deleteId">
    </form>
</div>

@section Scripts {
<script>
// 篩選欄位 ↔ 網址參數名稱 (刻意不用 tool/active/search，那三個會觸發 OnGet 的伺服器端過濾)
const CATALOG_FILTER_KEYS = { search: 'q', toolFilter: 'type', activeFilter: 'status', pathFilter: 'folder' };
// 儲存 / 刪除會整頁重載，送出前把篩選與捲動位置暫存於此，重載後還原
const CATALOG_RETURN_KEY = 'rc_catalog_return';

function catalogPage() {
    return {
        // 篩選
        search: '',
        toolFilter: '',
        activeFilter: '',
        pathFilter: '',

        // 資料
        items: [],
        catalogDepts: [],
        deptsTW: [],
        deptsCN: [],
        allDepObjects: [],
        allCategories: [],
        allPaths: [],
        reportFolders: [],
        baseUrls: { smartQuery: '', ssrs: '' },

        // Modal
        modalOpen: false,
        modalTab: 'basic',
        isEdit: false,
        editItem: null,
        form: {},
        selectedDepts: [],
        deps: [],
        depInput: '',
        depSugOpen: false,
        snapshot: '',
        errors: {},
        saving: false,

        // 剛操作過的列 (短暫標亮)
        highlightId: null,

        // 刪除
        deleteOpen: false,
        deleteItem: null,

        // 停用/啟用確認
        toggleOpen: false,
        toggleItem: null,
        toggling: false,

        // 部門明細
        deptModalOpen: false,
        deptModalItem: null,

        get filtered() {
            return this.items.filter(i => {
                if (this.toolFilter && i.reportTool !== this.toolFilter) return false;
                if (this.activeFilter === 'true' && !i.isActive) return false;
                if (this.activeFilter === 'false' && i.isActive) return false;
                if (this.pathFilter && i.reportPath !== this.pathFilter) return false;
                if (this.search) {
                    const q = this.search.toLowerCase();
                    return i.reportName.toLowerCase().includes(q) ||
                           (i.sourceName || '').toLowerCase().includes(q) ||
                           (i.reportPath || '').toLowerCase().includes(q);
                }
                return true;
            });
        },

        get hasFilter() {
            return Object.keys(CATALOG_FILTER_KEYS).some(k => this[k]);
        },

        clearFilters() {
            Object.keys(CATALOG_FILTER_KEYS).forEach(k => this[k] = '');
        },

        // 部門欄只列前兩個名稱，其餘以「等 N 個」連到明細，避免整排標籤擠成一團
        deptPreview(item) {
            return item.departments.slice(0, 2).map(d => d.deptName).join('、');
        },

        get filteredCategories() {
            return this.allCategories.filter(c => c.isActive);
        },

        get isDirty() {
            return this.modalOpen && this.formState() !== this.snapshot;
        },

        get depSuggestions() {
            if (!this.depInput) return [];
            const q = this.depInput.toLowerCase();
            return this.allDepObjects.filter(d =>
                d.toLowerCase().includes(q) && !this.deps.includes(d)
            );
        },

        init() {
            this.items = @Html.Raw(itemsJson);
            this.catalogDepts = @Html.Raw(catalogDeptsJson);
            this.deptsTW = @Html.Raw(deptsTwJson);
            this.deptsCN = @Html.Raw(deptsCnJson);
            this.allDepObjects = @Html.Raw(depObjectsJson);
            this.allCategories = @Html.Raw(categoriesJson);
            this.allPaths = @Html.Raw(reportPathsJson);
            this.reportFolders = @Html.Raw(reportFoldersJson);
            this.baseUrls = @Html.Raw(baseUrlsJson);

            // 檢查 URL 訊息
            const params = new URLSearchParams(window.location.search);
            const msg = params.get('msg');
            if (msg === 'saved') Alpine.store('toast').show('報表已儲存');
            if (msg === 'deleted') Alpine.store('toast').show('報表已刪除');
            if (msg === 'invalid') Alpine.store('toast').show('儲存失敗：報表名稱、報表代碼為必填，工具類型須為 SmartQuery 或 SSRS', 'error');

            // 篩選條件：操作後重載取暫存，其餘 (含重新整理) 取網址
            const ret = msg ? this.popReturnState() : null;
            this.applyFilterQuery(ret ? ret.query : window.location.search);
            this.syncUrl(); // 同時清掉 msg / focus / edit 參數
            Object.keys(CATALOG_FILTER_KEYS).forEach(k => this.$watch(k, () => this.syncUrl()));

            // 回到操作前的位置：剛儲存的列置中並標亮；刪除則還原捲動位置
            const focusId = parseInt(params.get('focus'));
            if (msg) {
                this.$nextTick(() => {
                    // 表格列與手機卡片只有一個可見，挑可見的那個捲動
                    const row = focusId && ['row-', 'card-']
                        .map(p => document.getElementById(p + focusId))
                        .find(el => el && el.offsetParent !== null);
                    if (row) {
                        row.scrollIntoView({ block: 'center' });
                        this.flashRow(focusId);
                    } else if (ret) {
                        window.scrollTo(0, ret.scrollY || 0);
                    }
                });
            }

            // 檢查是否有 edit 參數
            const editId = params.get('edit');
            if (editId) {
                const item = this.items.find(i => i.reportID === parseInt(editId));
                if (item) this.$nextTick(() => this.openEdit(item));
            }
        },

        filterQuery() {
            const p = new URLSearchParams();
            for (const [field, key] of Object.entries(CATALOG_FILTER_KEYS)) {
                if (this[field]) p.set(key, this[field]);
            }
            return p.toString();
        },

        applyFilterQuery(qs) {
            const p = new URLSearchParams(qs);
            for (const [field, key] of Object.entries(CATALOG_FILTER_KEYS)) {
                this[field] = p.get(key) || '';
            }
        },

        syncUrl() {
            const qs = this.filterQuery();
            window.history.replaceState({}, '', window.location.pathname + (qs ? '?' + qs : ''));
        },

        saveReturnState() {
            try {
                sessionStorage.setItem(CATALOG_RETURN_KEY,
                    JSON.stringify({ query: this.filterQuery(), scrollY: window.scrollY }));
            } catch { /* 無痕或停用儲存時略過，僅失去還原 */ }
        },

        popReturnState() {
            try {
                const raw = sessionStorage.getItem(CATALOG_RETURN_KEY);
                sessionStorage.removeItem(CATALOG_RETURN_KEY);
                return raw ? JSON.parse(raw) : null;
            } catch { return null; }
        },

        flashRow(id) {
            this.highlightId = id;
            clearTimeout(this._flashTimer);
            this._flashTimer = setTimeout(() => this.highlightId = null, 2500);
        },

        resetForm() {
            this.form = {
                reportID: 0, reportName: '', reportTool: 'SmartQuery',
                reportPath: '', reportCode: '', sourceName: '',
                isActive: true, remarks: '', useCompanyParam: false, categoryID: null
            };
            this.selectedDepts = [];
            this.deps = [];
            this.depInput = '';
        },

        openCreate() {
            this.resetForm();
            this.isEdit = false;
            this.showModal();
        },

        openEdit(item) {
            this.form = {
                reportID: item.reportID,
                reportName: item.reportName,
                reportTool: item.reportTool,
                reportPath: item.reportPath,
                reportCode: item.reportCode,
                sourceName: item.sourceName,
                isActive: item.isActive,
                remarks: item.remarks || '',
                useCompanyParam: item.useCompanyParam || false,
                categoryID: item.categoryID || null
            };
            this.selectedDepts = item.departments.map(d => String(d.deptID)).filter(Boolean);
            this.deps = [...(item.dependencies || [])];
            this.depInput = '';
            this.isEdit = true;
            this.editItem = item;
            this.showModal();
        },

        showModal() {
            this.errors = {};
            this.saving = false;
            this.modalTab = 'basic';
            this.snapshot = this.formState();
            this.modalOpen = true;
        },

        // 比對用：正規化後序列化，避免 select 回傳字串 / 勾選順序不同被誤判為變更
        formState() {
            const f = this.form;
            return JSON.stringify({
                ...f,
                reportPath: f.reportPath || '',
                sourceName: f.sourceName || '',
                categoryID: f.categoryID ? String(f.categoryID) : '',
                depts: [...this.selectedDepts].sort(),
                deps: this.deps
            });
        },

        closeModal() {
            if (this.isDirty && !confirm('有未儲存的變更，確定要放棄嗎？')) return;
            this.modalOpen = false;
        },

        // Esc 由最上層的視窗開始關；刪除確認可能疊在編輯視窗之上
        onKey(e) {
            if (e.key === 'Escape') {
                if (this.deleteOpen) this.deleteOpen = false;
                else if (this.toggleOpen) this.toggleOpen = false;
                else if (this.deptModalOpen) this.deptModalOpen = false;
                else if (this.modalOpen) this.closeModal();
            } else if (this.modalOpen && !this.deleteOpen
                       && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                e.preventDefault();
                this.save();
            }
        },

        toggleDept(deptId) {
            const idx = this.selectedDepts.indexOf(deptId);
            if (idx >= 0) this.selectedDepts.splice(idx, 1);
            else this.selectedDepts.push(deptId);
        },

        addDep() {
            const val = this.depInput.trim();
            if (val && !this.deps.includes(val)) {
                this.deps.push(val);
            }
            this.depInput = '';
            this.depSugOpen = false;
        },

        deptIdsString() {
            // 格式: deptID|deptName,deptID|deptName,...
            return this.selectedDepts.map(id => {
                const dept = this.catalogDepts.find(d => d.deptID === id);
                return dept ? dept.deptID + '|' + dept.deptName : '';
            }).filter(Boolean).join(',');
        },

        save() {
            if (this.saving) return;
            const errors = {};
            if (!this.form.reportName.trim()) errors.reportName = '請輸入報表名稱';
            if (!this.form.reportCode.trim()) errors.reportCode = '請輸入報表代碼';
            this.errors = errors;

            // 必填都在「基本設定」：切回該分頁並聚焦第一個錯誤欄位
            const firstError = Object.keys(errors)[0];
            if (firstError) {
                this.modalTab = 'basic';
                this.$nextTick(() => this.$refs[firstError + 'Input']?.focus());
                return;
            }

            this.saving = true;
            this.saveReturnState();
            this.$refs.saveForm.submit();
        },

        confirmToggle(item) {
            this.toggleItem = item;
            this.toggleOpen = true;
        },

        async doToggle() {
            if (this.toggling) return;
            const item = this.toggleItem;
            this.toggling = true;
            try {
                const form = new FormData();
                form.append('reportId', item.reportID);
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) form.append('__RequestVerificationToken', token);

                const res = await fetch('/Admin/Catalog?handler=Toggle', { method: 'POST', body: form });
                const data = await res.json();
                if (!data.success) {
                    Alpine.store('toast').show(data.message || '狀態更新失敗', 'error');
                    return;
                }

                item.isActive = data.isActive;
                item.displayDate = data.displayDate;
                this.toggleOpen = false;
                this.flashRow(item.reportID);
                Alpine.store('toast').show((data.isActive ? '已啟用「' : '已停用「') + item.reportName + '」');
            } catch (e) {
                Alpine.store('toast').show('狀態更新失敗，請重新整理後再試', 'error');
            } finally {
                this.toggling = false;
            }
        },

        showDepts(item) {
            this.deptModalItem = item;
            this.deptModalOpen = true;
        },

        confirmDelete(item) {
            this.deleteItem = item;
            this.deleteOpen = true;
        },

        doDelete() {
            this.$refs.deleteId.value = this.deleteItem.reportID;
            this.saveReturnState();
            this.$refs.deleteForm.submit();
        },

        toolClasses(tool) {
            const map = {
                'Internal': 'bg-emerald-50 text-emerald-700 border-emerald-200',
                'SmartQuery': 'bg-amber-50 text-amber-700 border-amber-200',
                'SSRS': 'bg-indigo-50 text-indigo-700 border-indigo-200',
            };
            return map[tool] || 'bg-surface text-txt-sec border-bdr';
        }
    };
}
</script>
}
