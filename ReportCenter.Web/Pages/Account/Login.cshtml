@page
@model ReportCenter.Web.Pages.Account.LoginModel
@{
    Layout = null;
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - @Model.SiteTitle</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png" />
    <script defer src="~/lib/alpinejs/3.15.12/cdn.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/fonts/noto-sans-tc/noto-sans-tc.css" asp-append-version="true" />
    <style>
        body { font-family: 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; }
        [x-cloak] { display: none !important; }
        :focus-visible { outline: 2px solid #00b4b6; outline-offset: 2px; }
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
        }
    </style>
    <!-- Tailwind CSS：由 Styles/input.css 於 dotnet build 時預先編譯 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface min-h-screen flex flex-col">
    <header class="h-14 bg-pri flex items-center px-4 md:px-5 shadow-[0_2px_8px_rgba(0,87,88,0.15)]">
        <img src="/images/logo.png" alt="ReportCenter" class="h-8 w-auto" />
    </header>

    <main class="flex-1 flex items-start sm:items-center justify-center px-4 py-10" x-data="loginPage()">
        <div class="w-full max-w-[380px] bg-white border border-bdr rounded-xl shadow-sm p-6 sm:p-8">
            <h1 class="text-[20px] font-bold text-txt">@Model.SiteTitle</h1>

            <!-- 自動登入中 -->
            <div x-show="state === 'checking'" class="mt-6 flex items-center gap-3 text-[14px] text-txt-sec" role="status">
                <svg class="w-5 h-5 animate-spin text-pri" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-20" />
                    <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
                正在確認登入狀態…
            </div>

            <!-- 帳密表單 -->
            <form x-show="state !== 'checking'" x-cloak method="post" class="mt-5 space-y-4" @@submit.prevent="submit()" novalidate>
                <p class="text-[13px] text-txt-sec leading-relaxed">
                    請輸入公司電腦的帳號密碼。登入後，PKPortal 等內部站台也不用再登入。
                </p>

                <div x-show="notice" x-text="notice" class="text-[13px] rounded-md bg-pri-light text-pri px-3 py-2"></div>
                <div x-show="error" x-text="error" class="text-[13px] rounded-md bg-bad/10 text-bad px-3 py-2" role="alert" aria-live="assertive"></div>

                <div>
                    <label for="username" class="block text-[13px] font-semibold text-txt mb-1.5">帳號（工號）</label>
                    <input id="username" name="username" type="text" x-model="username" x-ref="username"
                           autocomplete="username" autocapitalize="off" spellcheck="false" required
                           class="w-full h-11 rounded-md border border-bdr px-3 text-[15px] text-txt focus:border-pri focus:outline-none" />
                </div>
                <div>
                    <label for="password" class="block text-[13px] font-semibold text-txt mb-1.5">密碼</label>
                    <input id="password" name="password" type="password" x-model="password" x-ref="password"
                           autocomplete="current-password" required
                           class="w-full h-11 rounded-md border border-bdr px-3 text-[15px] text-txt focus:border-pri focus:outline-none" />
                </div>
                <button type="submit" :disabled="state === 'submitting'"
                        class="w-full h-11 rounded-md bg-pri hover:bg-pri-hover text-white text-[15px] font-semibold cursor-pointer disabled:opacity-60 disabled:cursor-wait">
                    <span x-text="state === 'submitting' ? '登入中…' : '登入'"></span>
                </button>
            </form>
        </div>
    </main>

    <script>
        function loginPage() {
            const apiBaseUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiBaseUrl, jsonOpts));
            const returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReturnUrl, jsonOpts));
            const loggedOut = @(Model.LoggedOut ? "true" : "false");

            // DataHubApi 回應格式：{ statusCode, message, data: { token, expiresAt } }
            async function readJson(res) {
                try { return await res.json(); } catch { return null; }
            }

            return {
                state: 'checking',   // checking → form → submitting
                username: '',
                password: '',
                error: '',
                notice: loggedOut ? '您已登出。' : '',

                // Alpine 會自動呼叫 init()，不要再加 x-init，否則會送兩次 Refresh
                async init() {
                    if (loggedOut || !apiBaseUrl) {
                        this.showForm();
                        return;
                    }
                    // 在 PKPortal 或其他站台登入過時，DataHubApi 的 Refresh Token Cookie 可直接換到新 Token
                    try {
                        const res = await fetch(apiBaseUrl + '/Auth/Refresh', { method: 'POST', credentials: 'include' });
                        if (res.ok) {
                            const body = await readJson(res);
                            if (body?.data?.token && await this.signIn(body.data.token)) return;
                        } else if (res.status === 429) {
                            this.error = '嘗試次數過多，請稍後再試。';
                        }
                    } catch {
                        // 網路錯誤：改用帳密登入
                    }
                    this.showForm();
                },

                showForm() {
                    this.state = 'form';
                    this.$nextTick(() => this.$refs.username.focus());
                },

                async submit() {
                    this.error = '';
                    this.notice = '';
                    if (!this.username.trim() || !this.password) {
                        this.error = '請輸入帳號與密碼。';
                        return;
                    }
                    if (!apiBaseUrl) {
                        this.error = '尚未設定登入服務，請聯絡資訊部。';
                        return;
                    }
                    this.state = 'submitting';
                    try {
                        const res = await fetch(apiBaseUrl + '/Auth/Login', {
                            method: 'POST',
                            credentials: 'include',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ username: this.username.trim(), password: this.password })
                        });
                        const body = await readJson(res);
                        if (res.ok && body?.data?.token) {
                            if (await this.signIn(body.data.token)) return;
                            this.error = '登入失敗，請再試一次。';
                        } else if (res.status === 429) {
                            this.error = '登入嘗試次數過多，請 5 分鐘後再試。';
                        } else {
                            this.error = body?.message || '登入失敗，請稍後再試。';
                        }
                    } catch {
                        this.error = '無法連線到登入服務，請確認網路後再試。';
                    }
                    this.password = '';
                    this.state = 'form';
                    this.$nextTick(() => this.$refs.password.focus());
                },

                // 把 DataHubApi 發出的 JWT 交給本站換本站 Cookie，成功後導回原頁
                async signIn(token) {
                    const fd = new FormData();
                    fd.append('token', token);
                    fd.append('returnUrl', returnUrl);
                    fd.append('__RequestVerificationToken',
                        document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    try {
                        const res = await fetch('/Account/Login?handler=SignIn', { method: 'POST', body: fd });
                        const body = await readJson(res);
                        if (res.ok && body?.success) {
                            location.replace(body.redirect || '/');
                            return true;
                        }
                    } catch {
                        // 交由呼叫端顯示表單
                    }
                    return false;
                }
            };
        }
    </script>
</body>
</html>
