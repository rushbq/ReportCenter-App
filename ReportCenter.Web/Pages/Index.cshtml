@page
@using ReportCenter.Web.Models
@model ReportCenter.Web.Pages.IndexModel

<div class="p-4 md:p-6 pb-10 max-w-[1200px]"
     x-data="{
        period: '本月',
        region: '全部',
        dept: '全部',
        chartPeriod: '月',
        periodOpen: false,
        regionOpen: false,
        deptOpen: false
     }">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div>
            <h1 class="text-[20px] md:text-[22px] font-bold text-txt">營運總覽</h1>
            <div class="text-[12px] text-txt-ter mt-1">@Model.Companies.FirstOrDefault(c => c.Id == Model.CurrentUser.CompanyId)?.ShortName ・ 最後更新 @Model.Kpi.LastUpdated</div>
        </div>
        <div class="flex gap-2 flex-wrap">
            <!-- 時間篩選 -->
            <div class="relative" @@click.outside="periodOpen = false">
                <span class="chip" :class="period !== '本月' && 'chip-active'" @@click="periodOpen = !periodOpen">
                    <i data-lucide="filter" class="w-3 h-3"></i><span x-text="period"></span>
                    <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
                </span>
                <div x-show="periodOpen" x-cloak class="absolute right-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[120px] z-40">
                    <template x-for="p in ['本月','上月','本季','本年']">
                        <button :class="period === p ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                                class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                                @@click="period = p; periodOpen = false" x-text="p"></button>
                    </template>
                </div>
            </div>
            <!-- 區域篩選 -->
            <div class="relative" @@click.outside="regionOpen = false">
                <span class="chip" :class="region !== '全部' && 'chip-active'" @@click="regionOpen = !regionOpen">
                    區域: <span x-text="region"></span>
                    <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
                </span>
                <div x-show="regionOpen" x-cloak class="absolute right-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[120px] z-40">
                    <template x-for="r in ['全部','北區','中區','南區','東區']">
                        <button :class="region === r ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                                class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                                @@click="region = r; regionOpen = false" x-text="r"></button>
                    </template>
                </div>
            </div>
            <!-- 部門篩選 -->
            <div class="relative" @@click.outside="deptOpen = false">
                <span class="chip" :class="dept !== '全部' && 'chip-active'" @@click="deptOpen = !deptOpen">
                    部門: <span x-text="dept"></span>
                    <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
                </span>
                <div x-show="deptOpen" x-cloak class="absolute right-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[120px] z-40">
                    <template x-for="d in ['全部','採購部','業務部','財務部','人資部','資訊部']">
                        <button :class="dept === d ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                                class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                                @@click="dept = d; deptOpen = false" x-text="d"></button>
                    </template>
                </div>
            </div>
            <!-- 更新 -->
            <span class="chip" @@click="window.location.reload()"><i data-lucide="refresh-cw" class="w-3 h-3"></i>更新</span>
        </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 mb-5">
        @foreach (var kpi in Model.Kpi.Items)
        {
            <partial name="_KpiCard" view-data='new ViewDataDictionary(ViewData) { { "title", kpi.Title }, { "value", kpi.Value }, { "trend", kpi.Trend.ToString() }, { "note", kpi.Note } }' />
        }
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-4 mb-6">
        <!-- Revenue Trend -->
        <div class="bg-white border border-bdr rounded-xl p-5 shadow-sm">
            <div class="flex justify-between items-center mb-1">
                <span class="font-semibold text-sm text-txt">營收趨勢</span>
                <div class="flex gap-1">
                    <template x-for="cp in ['月','季','年']">
                        <span class="chip" :class="chartPeriod === cp && 'chip-active'"
                              @@click="chartPeriod = cp; updateRevenueChart(cp)" x-text="cp"></span>
                    </template>
                </div>
            </div>
            <div class="relative h-[220px]">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
        <!-- Department Comparison -->
        <div class="bg-white border border-bdr rounded-xl p-5 shadow-sm">
            <span class="font-semibold text-sm text-txt">部門比較（百萬）</span>
            <div class="relative h-[220px] mt-2">
                <canvas id="deptChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick Access -->
    <div class="flex justify-between items-center mb-3.5">
        <span class="font-semibold text-[15px] text-txt">快速存取</span>
        <span class="text-[12px] text-pri font-medium cursor-pointer"
              x-data @@click="$store.search.toggle()">管理釘選 →</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        @foreach (var r in Model.QuickAccessItems)
        {
            <a href="/Report?dept=@r.DeptId&name=@System.Net.WebUtility.UrlEncode(r.Name)"
               class="bg-white border border-bdr rounded-[10px] p-4 flex flex-col gap-1.5 shadow-sm no-underline
                      hover:shadow-md hover:border-pri transition-all">
                <div class="flex justify-between items-center">
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-pri-light text-pri">@r.Dept</span>
                    <span x-data="{ fav: $store.favorites.has('@r.DeptId', '@r.Name') }"
                          @@click.prevent="$store.favorites.toggle('@r.DeptId', '@r.Name', '@r.Dept'); fav = !fav">
                        <i data-lucide="star" class="w-[13px] h-[13px]"
                           :class="fav ? 'text-[#f5a623] fill-[#f5a623]' : 'text-[#ddd]'"></i>
                    </span>
                </div>
                <span class="text-[13px] font-semibold text-txt leading-tight">@r.Name</span>
                <span class="text-[11px] text-txt-ter">#@r.Tag</span>
            </a>
        }
    </div>
</div>

@section Styles {
<style>
    .chip {
        font-size: 12px; padding: 5px 12px; border-radius: 6px; cursor: pointer;
        border: 1px solid #e2e8ea; background: white; color: #5c7576;
        white-space: nowrap; user-select: none; display: inline-flex; align-items: center; gap: 4px;
    }
    .chip-active {
        border-color: #005758; background: #e8f4f4; color: #005758; font-weight: 600;
    }
</style>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const C = { pri: '#005758', acc: '#00b4b6', priH: '#006d6e', ter: '#94aeb0', borderL: '#eef2f3' };

    // 月/季/年圖表資料
    const chartDataSets = {
        '月': {
            labels: ['10月','11月','12月','1月','2月','3月'],
            current: [10.2,11.1,12.5,10.8,11.6,12.8],
            last: [9.8,10.3,11.0,9.5,10.1,10.9],
            budget: [10.5,10.8,11.2,11.0,11.3,11.5]
        },
        '季': {
            labels: ['Q1','Q2','Q3','Q4'],
            current: [33.8,35.2,34.6,37.1],
            last: [30.2,32.1,31.5,33.8],
            budget: [32.0,33.5,34.0,35.0]
        },
        '年': {
            labels: ['2022','2023','2024','2025','2026(預)'],
            current: [105.3,118.6,128.2,140.5,152.0],
            last: [95.1,105.3,118.6,128.2,140.5],
            budget: [100.0,112.0,125.0,138.0,150.0]
        }
    };

    // Revenue Trend Chart
    const revenueCtx = document.getElementById('revenueChart');
    const revenueChart = new Chart(revenueCtx, {
        type: 'line',
        data: {
            labels: chartDataSets['月'].labels,
            datasets: [
                {
                    label: '本年', data: chartDataSets['月'].current,
                    borderColor: C.pri, backgroundColor: C.pri + '20',
                    borderWidth: 2.5, fill: true, tension: 0.4, pointRadius: 0,
                },
                {
                    label: '去年', data: chartDataSets['月'].last,
                    borderColor: C.acc, borderWidth: 1.5, borderDash: [4,3],
                    fill: false, tension: 0.4, pointRadius: 0,
                },
                {
                    label: '預算', data: chartDataSets['月'].budget,
                    borderColor: C.ter, borderWidth: 1, borderDash: [2,2],
                    fill: false, tension: 0.4, pointRadius: 0,
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter } },
                y: { grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter, callback: v => v + 'M' } }
            }
        }
    });

    // 全域函式：更新營收圖表
    window.updateRevenueChart = function(period) {
        const ds = chartDataSets[period];
        revenueChart.data.labels = ds.labels;
        revenueChart.data.datasets[0].data = ds.current;
        revenueChart.data.datasets[1].data = ds.last;
        revenueChart.data.datasets[2].data = ds.budget;
        revenueChart.update();
    };

    // Dept Comparison Chart
    new Chart(document.getElementById('deptChart'), {
        type: 'bar',
        data: {
            labels: ['採購部','業務部','財務部','人資部','資訊部'],
            datasets: [
                { label: '實際', data: [4.2,5.8,1.2,0.8,1.6], backgroundColor: C.pri, borderRadius: 4, barPercentage: 0.6 },
                { label: '目標', data: [4.5,5.2,1.3,0.9,1.8], backgroundColor: C.borderL, borderRadius: 4, barPercentage: 0.6 }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { font: { size: 10 }, color: C.ter } },
                y: { grid: { color: C.borderL }, ticks: { font: { size: 11 }, color: C.ter } }
            }
        }
    });
});
</script>
}
