@page
@using ReportCenter.Web.Models
@using ReportCenter.Web.Helpers
@model ReportCenter.Web.Pages.DepartmentModel

@{
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var reportsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Reports.Select(r => new {
            reportId = r.ReportID, name = r.Name, desc = r.Desc, cat = r.Cat,
            updated = r.Updated, reportTool = r.ReportTool, reportCode = r.ReportCode,
            useCompanyParam = r.UseCompanyParam
        }), jsonOpts
    );
    var favoriteIdsJson = System.Text.Json.JsonSerializer.Serialize(Model.FavoriteIds, jsonOpts);

    // 依部門內分類序位指派顏色，保證同一頁面各分類色差最大 (前端卡片/列表沿用此對照)
    var catColorMap = new Dictionary<string, string>();
    for (var i = 0; i < Model.Dept.Subs.Count; i++)
        catColorMap[Model.Dept.Subs[i]] = CategoryPalette.BadgeByIndex(i);
    var catColorMapJson = System.Text.Json.JsonSerializer.Serialize(catColorMap, jsonOpts);
}

<div class="page-container" x-data="deptPage()" x-init="init()">
    <!-- Breadcrumb -->
    <div class="text-[12px] text-txt-ter mb-3.5">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a> /
        部門報表 /
        <span class="text-pri font-semibold">@Model.Dept.Label</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[10px] bg-pri-light flex items-center justify-center shrink-0">
                <i data-lucide="@Model.Dept.Icon" class="w-5 h-5 text-pri"></i>
            </div>
            <div>
                <h1 class="text-lg md:text-[20px] font-bold text-txt">@Model.Dept.Label 報表</h1>
                <div class="text-[12px] text-txt-ter mt-0.5" aria-live="polite">共 <span x-text="filtered.length"></span> 份報表</div>
            </div>
        </div>
        <div class="flex gap-2 items-center w-full sm:w-auto">
            <div class="bg-white border border-bdr rounded-lg px-3 py-[7px] flex items-center gap-1.5 flex-1 sm:flex-none sm:w-[220px]">
                <i data-lucide="search" class="w-3.5 h-3.5 text-txt-ter"></i>
                <input type="text" placeholder="搜尋部門報表…" aria-label="搜尋部門報表" x-model="searchQuery"
                       class="flex-1 bg-transparent border-0 outline-none text-[12px] text-txt placeholder:text-txt-ter w-full" />
                <button x-show="searchQuery" @@click="searchQuery = ''" aria-label="清除搜尋" class="bg-transparent border-0 cursor-pointer p-0">
                    <i data-lucide="x" class="w-3 h-3 text-txt-ter"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Desktop Tabs -->
    <div class="hidden md:flex border-b-2 border-bdr mb-4">
        <button @@click="tab='all'" :aria-pressed="tab==='all'"
                :class="tab==='all' ? 'font-semibold text-pri border-b-2 border-pri' : 'text-txt-sec border-b-2 border-transparent'"
                class="px-4 py-2.5 text-[13px] cursor-pointer -mb-[2px] flex items-center gap-1.5 bg-transparent whitespace-nowrap">
            全部
            <span :class="tab==='all' ? 'bg-pri-light text-pri' : 'bg-bdr-light text-txt-sec'"
                  class="badge" x-text="tabCount('all')"></span>
        </button>
        @for (var i = 0; i < Model.Dept.Subs.Count; i++)
        {
            var sub = Model.Dept.Subs[i];
            <button @@click="tab='@sub'" :aria-pressed="tab==='@sub'"
                    :class="tab==='@sub' ? 'font-semibold text-pri border-b-2 border-pri' : 'text-txt-sec border-b-2 border-transparent'"
                    class="px-4 py-2.5 text-[13px] cursor-pointer -mb-[2px] flex items-center gap-1.5 bg-transparent whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full shrink-0 @CategoryPalette.DotByIndex(i)"></span>
                @sub
                <span :class="tab==='@sub' ? 'bg-pri-light text-pri' : 'bg-bdr-light text-txt-sec'"
                      class="badge" x-text="tabCount('@sub')"></span>
            </button>
        }
    </div>
    <!-- Mobile Tabs (單列水平捲動，避免換行擁擠) -->
    <div class="flex md:hidden gap-2 mb-4 overflow-x-auto no-scrollbar -mx-4 px-4">
        <button @@click="tab='all'" :aria-pressed="tab==='all'"
                :class="tab==='all' ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr'"
                class="shrink-0 whitespace-nowrap px-3 py-1.5 text-[13px] cursor-pointer rounded-full border flex items-center gap-1.5">
            全部
            <span :class="tab==='all' ? 'bg-white/20 text-white' : 'bg-bdr-light text-txt-sec'"
                  class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full" x-text="tabCount('all')"></span>
        </button>
        @for (var i = 0; i < Model.Dept.Subs.Count; i++)
        {
            var sub = Model.Dept.Subs[i];
            <button @@click="tab='@sub'" :aria-pressed="tab==='@sub'"
                    :class="tab==='@sub' ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr'"
                    class="shrink-0 whitespace-nowrap px-3 py-1.5 text-[13px] cursor-pointer rounded-full border flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full shrink-0 @CategoryPalette.DotByIndex(i)" :class="tab==='@sub' && 'ring-1 ring-white/60'"></span>
                @sub
                <span :class="tab==='@sub' ? 'bg-white/20 text-white' : 'bg-bdr-light text-txt-sec'"
                      class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full" x-text="tabCount('@sub')"></span>
            </button>
        }
    </div>

    <!-- 部門無任何報表 (伺服器端即可判定，與「篩選無結果」區分) -->
    @if (Model.Reports.Count == 0)
    {
        <div class="text-center py-12">
            <i data-lucide="inbox" class="w-10 h-10 text-txt-ter mx-auto mb-3"></i>
            <div class="text-txt-sec text-sm">此部門尚未提供任何報表</div>
        </div>
    }

    <!-- 篩選無結果 -->
    <div x-show="reports.length > 0 && filtered.length === 0" x-cloak class="text-center py-12">
        <i data-lucide="search-x" class="w-10 h-10 text-txt-ter mx-auto mb-3"></i>
        <div class="text-txt-sec text-sm">找不到符合條件的報表</div>
        <button @@click="searchQuery = ''; tab = 'all'"
                class="mt-3 text-[13px] text-pri font-medium cursor-pointer bg-transparent border-0 underline">清除篩選</button>
    </div>

    <!-- Card View -->
    <div x-show="filtered.length > 0" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        <template x-for="r in filtered" :key="r.reportId">
            <a :href="getReportHref(r)" target="_blank" rel="noopener"
               :data-report-id="r.reportId" data-report-source="department"
               class="group bg-white border border-bdr rounded-[10px] p-4 flex flex-col gap-2 shadow-sm no-underline
                      hover:shadow-md hover:border-pri hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex items-center justify-between gap-2 min-h-[22px]">
                    <span class="badge" :class="catBadge(r.cat)" x-text="r.cat" x-show="r.cat"></span>
                    <span role="button" tabindex="0" :aria-label="isFav(r.reportId) ? '取消收藏 ' + r.name : '收藏 ' + r.name"
                          :aria-pressed="isFav(r.reportId)"
                          class="ml-auto -my-1.5 -mr-1.5 p-2 rounded-full cursor-pointer hover:bg-surface transition-colors"
                          @@click.prevent.stop="toggleFav(r.reportId)"
                          @@keydown.enter.prevent.stop="toggleFav(r.reportId)"
                          @@keydown.space.prevent.stop="toggleFav(r.reportId)">
                        <svg class="w-3.5 h-3.5 transition-transform hover:scale-110" :class="isFav(r.reportId) ? 'text-star fill-star' : 'text-txt-ter fill-none'" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </span>
                </div>
                <div class="flex items-start gap-1.5">
                    <span class="text-[15px] font-semibold text-txt leading-snug flex-1 group-hover:text-pri transition-colors" x-text="r.name"></span>
                    <svg class="w-3.5 h-3.5 text-txt-ter shrink-0 mt-0.5 group-hover:text-pri transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </div>
                <span class="text-[12px] text-txt-sec leading-relaxed" x-show="r.desc" x-text="r.desc"></span>
            </a>
        </template>
    </div>

</div>

@section Scripts {
<script>
function deptPage() {
    return {
        tab: 'all',
        searchQuery: '',
        reports: [],
        favoriteIds: [],
        catColors: {},
        baseUrls: { smartQuery: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SmartQueryBaseUrl)), ssrs: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SsrsBaseUrl)) },

        init() {
            this.reports = @Html.Raw(reportsJson);
            this.favoriteIds = @Html.Raw(favoriteIdsJson);
            this.catColors = @Html.Raw(catColorMapJson);
            // 從 URL 讀取 cat 參數以預設分類 tab
            const params = new URLSearchParams(window.location.search);
            const cat = params.get('cat');
            if (cat && this.reports.some(r => r.cat === cat)) {
                this.tab = cat;
            }
        },

        catBadge(cat) {
            // 依部門內分類序位配色 (與伺服器端分頁一致)；未知分類退回全站雜湊配色
            return this.catColors[cat] || window.catBadge(cat);
        },

        getReportHref(r) {
            let url = r.reportTool === 'SSRS'
                ? this.baseUrls.ssrs + r.reportCode
                : this.baseUrls.smartQuery + r.reportCode;
            if (r.useCompanyParam) {
                const companyId = document.cookie.split('; ').find(c => c.startsWith('companyId='))?.split('=')[1] || '';
                const sep = url.includes('?') ? '&' : '?';
                url += sep + 'dbs=' + encodeURIComponent(companyId);
            }
            return url;
        },

        isFav(reportId) {
            return this.favoriteIds.includes(reportId);
        },

        async toggleFav(reportId) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Api/Favorite?handler=Toggle&reportId=' + reportId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token || '' }
                });
                const data = await res.json();
                if (data.success) {
                    const r = this.reports.find(x => x.reportId === reportId);
                    if (data.isFavorite) {
                        this.favoriteIds.push(reportId);
                        Alpine.store('toast').show('已加入收藏');
                        // 通知 sidebar 更新收藏
                        const href = this.getReportHref(r);
                        window.dispatchEvent(new CustomEvent('fav-changed', { detail: { reportId, isFavorite: true, report: { reportId, name: r.name, href, target: '_blank' } } }));
                    } else {
                        this.favoriteIds = this.favoriteIds.filter(id => id !== reportId);
                        Alpine.store('toast').show('已取消收藏');
                        window.dispatchEvent(new CustomEvent('fav-changed', { detail: { reportId, isFavorite: false } }));
                    }
                }
            } catch (e) {
                console.error('收藏切換失敗', e);
            }
        },

        // 搜尋篩選 (filtered 與 tabCount 共用，避免邏輯分岔)
        baseFiltered() {
            let list = this.reports;
            if (this.searchQuery.trim()) {
                const q = this.searchQuery.trim().toLowerCase();
                list = list.filter(r =>
                    r.name.toLowerCase().includes(q) ||
                    r.desc.toLowerCase().includes(q) ||
                    r.cat.toLowerCase().includes(q)
                );
            }
            return list;
        },

        get filtered() {
            let list = this.baseFiltered();
            if (this.tab !== 'all') list = list.filter(r => r.cat === this.tab);
            // 固定依更新日期新到舊 (updated 為 yyyy/MM/dd 零填格式，可直接字串排序)
            return [...list].sort((a, b) => b.updated.localeCompare(a.updated));
        },

        tabCount(cat) {
            const list = this.baseFiltered();
            return cat === 'all' ? list.length : list.filter(r => r.cat === cat).length;
        }
    };
}
</script>
}
