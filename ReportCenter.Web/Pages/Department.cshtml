@page
@using ReportCenter.Web.Models
@model ReportCenter.Web.Pages.DepartmentModel

@{
    var reportsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Reports.Select(r => new { name = r.Name, desc = r.Desc, cat = r.Cat, updated = r.Updated, fav = r.Fav })
    );
}

<div class="p-4 md:p-6 pb-10 max-w-[1200px]" x-data="deptPage()" x-init="init()">
    <!-- Breadcrumb -->
    <div class="text-[12px] text-txt-ter mb-3.5">
        <a href="/" class="hover:text-pri no-underline text-txt-ter">首頁</a> /
        部門報表 /
        <span class="text-pri font-semibold">@Model.Dept.Label</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start mb-5 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[10px] bg-pri-light flex items-center justify-center shrink-0">
                <i data-lucide="@Model.Dept.Icon" class="w-5 h-5 text-pri"></i>
            </div>
            <div>
                <h1 class="text-lg md:text-[20px] font-bold text-txt">@Model.Dept.Label 報表</h1>
                <div class="text-[12px] text-txt-ter mt-0.5">共 <span x-text="filtered.length"></span> 份報表</div>
            </div>
        </div>
        <div class="flex gap-2 items-center">
            <div class="bg-white border border-bdr rounded-lg px-3 py-[7px] flex items-center gap-1.5 w-[220px]">
                <i data-lucide="search" class="w-3.5 h-3.5 text-txt-ter"></i>
                <input type="text" placeholder="搜尋部門報表…" x-model="searchQuery"
                       class="flex-1 bg-transparent border-0 outline-none text-[12px] text-txt placeholder:text-txt-ter w-full" />
                <button x-show="searchQuery" @@click="searchQuery = ''" class="bg-transparent border-0 cursor-pointer p-0">
                    <i data-lucide="x" class="w-3 h-3 text-txt-ter"></i>
                </button>
            </div>
            <div class="flex border border-bdr rounded-lg overflow-hidden">
                <button @@click="view='card'" :class="view==='card' ? 'bg-pri text-white' : 'bg-white text-txt-ter'" class="px-2.5 py-1.5 cursor-pointer border-0">
                    <i data-lucide="grid-3x3" class="w-3.5 h-3.5"></i>
                </button>
                <button @@click="view='table'" :class="view==='table' ? 'bg-pri text-white' : 'bg-white text-txt-ter'" class="px-2.5 py-1.5 cursor-pointer border-0">
                    <i data-lucide="list" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Desktop Tabs -->
    <div class="hidden md:flex border-b-2 border-bdr mb-4">
        <button @@click="tab='all'"
                :class="tab==='all' ? 'font-semibold text-pri border-b-2 border-pri' : 'text-txt-sec border-b-2 border-transparent'"
                class="px-4 py-2.5 text-[13px] cursor-pointer -mb-[2px] flex items-center gap-1.5 bg-transparent whitespace-nowrap">
            全部
            <span :class="tab==='all' ? 'bg-pri-light text-pri' : 'bg-bdr-light text-txt-ter'"
                  class="text-[10px] font-semibold px-2 py-0.5 rounded-full" x-text="tabCount('all')"></span>
        </button>
        @foreach (var sub in Model.Dept.Subs)
        {
            <button @@click="tab='@sub'"
                    :class="tab==='@sub' ? 'font-semibold text-pri border-b-2 border-pri' : 'text-txt-sec border-b-2 border-transparent'"
                    class="px-4 py-2.5 text-[13px] cursor-pointer -mb-[2px] flex items-center gap-1.5 bg-transparent whitespace-nowrap">
                @sub
                <span :class="tab==='@sub' ? 'bg-pri-light text-pri' : 'bg-bdr-light text-txt-ter'"
                      class="text-[10px] font-semibold px-2 py-0.5 rounded-full" x-text="tabCount('@sub')"></span>
            </button>
        }
    </div>
    <!-- Mobile Tabs -->
    <div class="flex md:hidden flex-wrap gap-2 mb-4">
        <button @@click="tab='all'"
                :class="tab==='all' ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr'"
                class="px-3 py-1.5 text-[13px] cursor-pointer rounded-full border flex items-center gap-1.5">
            全部
            <span :class="tab==='all' ? 'bg-white/20 text-white' : 'bg-bdr-light text-txt-ter'"
                  class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full" x-text="tabCount('all')"></span>
        </button>
        @foreach (var sub in Model.Dept.Subs)
        {
            <button @@click="tab='@sub'"
                    :class="tab==='@sub' ? 'bg-pri text-white border-pri' : 'bg-white text-txt-sec border-bdr'"
                    class="px-3 py-1.5 text-[13px] cursor-pointer rounded-full border flex items-center gap-1.5">
                @sub
                <span :class="tab==='@sub' ? 'bg-white/20 text-white' : 'bg-bdr-light text-txt-ter'"
                      class="text-[10px] font-semibold px-1.5 py-0.5 rounded-full" x-text="tabCount('@sub')"></span>
            </button>
        }
    </div>

    <!-- Filters -->
    <div class="flex gap-2 mb-4">
        <div class="relative" @@click.outside="dateOpen = false">
            <span class="chip" :class="dateFilter !== '全部' && 'chip-active'" @@click="dateOpen = !dateOpen">
                <i data-lucide="filter" class="w-3 h-3"></i>日期: <span x-text="dateFilter"></span>
                <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
            </span>
            <div x-show="dateOpen" x-cloak class="absolute left-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[120px] z-40">
                <template x-for="d in ['全部','本週','本月','本季']">
                    <button :class="dateFilter === d ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                            class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                            @@click="dateFilter = d; dateOpen = false" x-text="d"></button>
                </template>
            </div>
        </div>
        <div class="relative" @@click.outside="sortOpen = false">
            <span class="chip" @@click="sortOpen = !sortOpen">
                排序: <span x-text="sortBy"></span>
                <i data-lucide="chevron-down" class="w-3 h-3 opacity-50"></i>
            </span>
            <div x-show="sortOpen" x-cloak class="absolute left-0 mt-1 bg-white rounded-lg shadow-lg border border-bdr py-1 min-w-[130px] z-40">
                <template x-for="s in ['最近更新','最早更新','名稱 A-Z']">
                    <button :class="sortBy === s ? 'bg-pri-light text-pri font-semibold' : 'text-txt hover:bg-surface'"
                            class="w-full text-left px-4 py-2 text-[13px] cursor-pointer border-0 bg-transparent"
                            @@click="sortBy = s; sortOpen = false" x-text="s"></button>
                </template>
            </div>
        </div>
    </div>

    <!-- No Results -->
    <div x-show="filtered.length === 0" x-cloak class="text-center py-12">
        <i data-lucide="search-x" class="w-10 h-10 text-txt-ter mx-auto mb-3"></i>
        <div class="text-txt-sec text-sm">找不到符合條件的報表</div>
        <button @@click="searchQuery = ''; tab = 'all'; dateFilter = '全部'"
                class="mt-3 text-[13px] text-pri font-medium cursor-pointer bg-transparent border-0 underline">清除篩選</button>
    </div>

    <!-- Card View -->
    <div x-show="view==='card' && filtered.length > 0" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        <template x-for="r in filtered" :key="r.name">
            <a :href="'/Report?dept=@Model.DeptId&name=' + encodeURIComponent(r.name)"
               class="bg-white border border-bdr rounded-[10px] p-[18px] flex flex-col gap-2 shadow-sm no-underline
                      hover:shadow-md hover:border-pri transition-all">
                <div class="flex justify-between items-center">
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-pri-light text-pri" x-text="r.cat"></span>
                    <span @@click.prevent="$store.favorites.toggle('@Model.DeptId', r.name, '@Model.Dept.Label'); lucide.createIcons()">
                        <i data-lucide="star" class="w-3.5 h-3.5"
                           :class="$store.favorites.has('@Model.DeptId', r.name) ? 'text-[#f5a623] fill-[#f5a623]' : 'text-[#ddd]'"></i>
                    </span>
                </div>
                <span class="text-sm font-semibold text-txt" x-text="r.name"></span>
                <span class="text-[12px] text-txt-sec leading-relaxed" x-text="r.desc"></span>
                <div class="flex justify-between items-center mt-1">
                    <span class="text-[11px] text-txt-ter">更新 <span x-text="r.updated"></span></span>
                    <span class="text-[12px] text-pri font-semibold flex items-center gap-1">
                        <i data-lucide="eye" class="w-3 h-3"></i> 檢視
                    </span>
                </div>
            </a>
        </template>
    </div>

    <!-- Table View -->
    <div x-show="view==='table' && filtered.length > 0" x-cloak class="bg-white border border-bdr rounded-[10px] overflow-hidden shadow-sm overflow-x-auto">
        <div class="grid grid-cols-[2.2fr_3fr_1fr_0.8fr_80px] px-5 py-2.5 bg-surface text-[11px] font-bold text-txt-ter uppercase tracking-wider">
            <span>報表名稱</span><span>說明</span><span>分類</span><span>更新</span><span>操作</span>
        </div>
        <template x-for="r in filtered" :key="r.name">
            <a :href="'/Report?dept=@Model.DeptId&name=' + encodeURIComponent(r.name)"
               class="grid grid-cols-[2.2fr_3fr_1fr_0.8fr_80px] px-5 py-3 border-t border-bdr-light text-[13px] items-center
                      no-underline hover:bg-[#fafcfc] transition-colors">
                <span class="font-medium text-txt flex items-center gap-1.5">
                    <span @@click.prevent="$store.favorites.toggle('@Model.DeptId', r.name, '@Model.Dept.Label')">
                        <i data-lucide="star" class="w-[11px] h-[11px]"
                           :class="$store.favorites.has('@Model.DeptId', r.name) ? 'text-[#f5a623] fill-[#f5a623]' : 'text-[#ddd]'"></i>
                    </span>
                    <span x-text="r.name"></span>
                </span>
                <span class="text-txt-sec text-[12px]" x-text="r.desc"></span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-pri-light text-pri inline-block w-fit" x-text="r.cat"></span>
                <span class="text-[12px] text-txt-ter" x-text="r.updated"></span>
                <span class="text-[12px] text-pri font-semibold flex items-center gap-1">
                    <i data-lucide="eye" class="w-3 h-3"></i> 檢視
                </span>
            </a>
        </template>
    </div>
</div>

@section Styles {
<style>
    .chip {
        font-size: 12px; padding: 5px 12px; border-radius: 6px; cursor: pointer;
        border: 1px solid #e2e8ea; background: white; color: #5c7576;
        white-space: nowrap; user-select: none; display: inline-flex; align-items: center; gap: 4px;
    }
    .chip-active {
        border-color: #005758; background: #e8f4f4; color: #005758; font-weight: 600;
    }
</style>
}

@section Scripts {
<script>
function deptPage() {
    return {
        view: 'card',
        tab: 'all',
        searchQuery: '',
        dateFilter: '全部',
        sortBy: '最近更新',
        dateOpen: false,
        sortOpen: false,
        reports: [],

        init() {
            this.reports = @Html.Raw(reportsJson);
        },

        get filtered() {
            let list = this.reports;
            if (this.tab !== 'all') list = list.filter(r => r.cat === this.tab);
            if (this.searchQuery.trim()) {
                const q = this.searchQuery.trim().toLowerCase();
                list = list.filter(r =>
                    r.name.toLowerCase().includes(q) ||
                    r.desc.toLowerCase().includes(q) ||
                    r.cat.toLowerCase().includes(q)
                );
            }
            if (this.sortBy === '名稱 A-Z') list = [...list].sort((a, b) => a.name.localeCompare(b.name, 'zh-TW'));
            else if (this.sortBy === '最早更新') list = [...list].sort((a, b) => a.updated.localeCompare(b.updated));
            else list = [...list].sort((a, b) => b.updated.localeCompare(a.updated));
            return list;
        },

        tabCount(cat) {
            let list = this.reports;
            if (cat !== 'all') list = list.filter(r => r.cat === cat);
            if (this.searchQuery.trim()) {
                const q = this.searchQuery.trim().toLowerCase();
                list = list.filter(r =>
                    r.name.toLowerCase().includes(q) ||
                    r.desc.toLowerCase().includes(q) ||
                    r.cat.toLowerCase().includes(q)
                );
            }
            return list.length;
        }
    };
}
</script>
}
